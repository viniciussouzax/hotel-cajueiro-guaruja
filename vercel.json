{
  "git": {
    "deploymentEnabled": {
      "master": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-sequences",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    { "source": "/contato-hotel-cajueiro-guaruja", "destination": "/contato", "permanent": true }
  ],
  "rewrites": [
    { "source": "/search/:term", "destination": "/search?q=:term" }
  ]
}
