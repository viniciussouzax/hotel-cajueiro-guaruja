---
/**
 * MetaPixel.astro — Plugin Meta Pixel (Facebook Pixel)
 *
 * Injeta o rastreamento no <head> de todas as páginas públicas. Dois modos:
 * - trackingScript preenchido: carrega o script do tracking-kit (pixel + API de Conversões
 *   + dataLayer, com deduplicação). O pixel vem do kit, então o snippet abaixo não é usado.
 * - só pixelId: snippet padrão do Meta Pixel (apenas navegador).
 * Lê de src/data/pluginsConfig.json via readData().
 * Se cookieConsent.enabled for true, aguarda o evento 'cookies-accepted'
 * ou verifica localStorage antes de carregar o script.
 * Se os dois estiverem vazios, não renderiza nada.
 */
import { readData } from '../../lib/readData';

const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const pixelId: string = pluginsConfig?.metaPixel?.pixelId?.trim() || '';
const trackingScript: string = pluginsConfig?.metaPixel?.trackingScript?.trim() || '';
const requireConsent: boolean = pluginsConfig?.cookieConsent?.enabled !== false;
---

{trackingScript && (
  <script define:vars={{ trackingScript, requireConsent }}>
  (function() {
    function loadKit() {
      if (window.__tracking_kit_loaded) return;
      window.__tracking_kit_loaded = true;
      var s = document.createElement('script');
      s.src = trackingScript;
      s.defer = true;
      document.head.appendChild(s);
    }

    // Mesmo adiamento do GoogleTag.astro (6 s depois do load ou primeira interação):
    // o kit puxa o fbevents.js e a config do pixel (~275 KB), que disputavam banda com a hero.
    // shortcut: visita que sai em menos de 6 s sem tocar nem rolar não gera PageView.
    var depois = window.__depoisDoLoad = window.__depoisDoLoad || function (fn) {
      var feito = false, ev = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      function go() { if (feito) return; feito = true; ev.forEach(function (e) { removeEventListener(e, go, true); }); fn(); }
      ev.forEach(function (e) { addEventListener(e, go, { capture: true, passive: true }); });
      function ocioso() { setTimeout(go, 6000); }
      if (document.readyState === 'complete') ocioso(); else addEventListener('load', ocioso, { once: true });
    };

    depois(function () {
      if (!requireConsent || localStorage.getItem('cookies-accepted') === 'true') {
        loadKit();
      } else {
        window.addEventListener('cookies-accepted', loadKit, { once: true });
      }
    });
  })();
  </script>
)}

{!trackingScript && pixelId && (
  <script define:vars={{ pixelId, requireConsent }}>
  (function() {
    function loadPixel() {
      if (window.__fbq_loaded) return;
      window.__fbq_loaded = true;
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixelId);
      fbq('track', 'PageView');
    }

    // Mesmo adiamento do bloco acima.
    var depois = window.__depoisDoLoad = window.__depoisDoLoad || function (fn) {
      var feito = false, ev = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      function go() { if (feito) return; feito = true; ev.forEach(function (e) { removeEventListener(e, go, true); }); fn(); }
      ev.forEach(function (e) { addEventListener(e, go, { capture: true, passive: true }); });
      function ocioso() { setTimeout(go, 6000); }
      if (document.readyState === 'complete') ocioso(); else addEventListener('load', ocioso, { once: true });
    };
    depois(function () {
      if (!requireConsent || localStorage.getItem('cookies-accepted') === 'true') {
        loadPixel();
      } else {
        window.addEventListener('cookies-accepted', loadPixel, { once: true });
      }
    });
  })();
  </script>
)}
