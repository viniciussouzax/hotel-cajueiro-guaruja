---
import { readData } from '../../lib/readData';
import { normalizeCategories, collectOrphanCategories } from '../../lib/categorySlug';
import { getCollection } from 'astro:content';

const siteConfig = readData('siteConfig.json');
const menuItems: any[] = readData('menu.json', { items: [] }).items || [];

// CTA de WhatsApp do header — usa o contato do hotel (siteConfig.contact).
const waNumber = (siteConfig.contact?.whatsapp || '').replace(/\D/g, '');
const waUrl = waNumber
  ? `https://wa.me/55${waNumber}?text=${encodeURIComponent('Olá! Vim pelo site e gostaria de fazer uma reserva.')}`
  : '';

const posts = await getCollection('blog');
const categoriesData = readData('categories.json', []);
const registered = normalizeCategories(categoriesData);
const postCats = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const orphans = collectOrphanCategories(postCats, registered);
const allCategories = registered.length > 0 ? [...registered, ...orphans] : orphans;

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);

const menuHover = siteConfig.menuHoverEnabled !== false;

// transparent = header transparente sobre a hero (só onde há hero escura, ex. home).
// Ativa o modo "sólido no scroll" via JS. Sem a prop, header é sempre branco sólido.
const { transparent = false } = Astro.props;
---

<header id="site-header" class="site-header z-40" data-transparent={transparent ? 'true' : undefined}>
  <div class="container-x flex items-center justify-between h-[68px] gap-6">
    <a href="/" class="flex items-center no-underline" aria-label="Home">
      <img src="/images/logo-preto.png" alt={siteConfig.name} class="logo logo-dark w-auto" style="height: 40px" />
      <img src="/images/logo-branco.png" alt="" aria-hidden="true" class="logo logo-light w-auto" style="height: 48px" />
    </a>

    <nav class="hidden lg:flex items-center gap-7 flex-1 justify-center" aria-label="Principal">
      {menuItems.map((item: any) => (
        item.showCategories ? (
          <div class="relative group" data-submenu>
            <button
              type="button"
              data-submenu-toggle
              class={`nav-link text-sm font-medium transition-colors flex items-center gap-1 ${isActive(item.href) ? 'is-current' : ''}`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <svg width="10" height="10" viewBox="0 0 10 10" class="opacity-60" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <ul class={`submenu-panel absolute top-full left-1/2 -translate-x-1/2 mt-2 min-w-[200px] bg-surface border border-rule rounded-md opacity-0 invisible transition-all py-2 z-50 shadow-[0_8px_24px_-12px_rgba(80,40,20,0.18)] ${menuHover ? 'group-hover:opacity-100 group-hover:visible' : ''}`}>
              <li><a href={item.href} class="block px-4 py-2 text-sm text-ink hover:text-primary">Todos os artigos</a></li>
              {allCategories.map((cat) => (
                <li><a href={`/categoria/${cat.slug}`} class="block px-4 py-2 text-sm text-ink hover:text-primary">{cat.name}</a></li>
              ))}
            </ul>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`nav-link text-sm font-medium transition-colors ${isActive(item.href) ? 'is-current' : ''}`}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="flex items-center gap-1">
      {waUrl && (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center min-h-[40px] px-5 rounded-[20px] bg-[#cf3a23] text-white text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition mr-1"
        >
          Reservar
        </a>
      )}
      <button id="menu-toggle" class="nav-icon lg:hidden w-10 h-10 flex items-center justify-center rounded transition-colors" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden bg-surface border-t border-rule">
    <nav class="container-x py-4 space-y-1" aria-label="Mobile">
      {menuItems.map((item: any) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class={`block py-2.5 text-base ${isActive(item.href) ? 'text-ink font-semibold' : 'text-ink-muted'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* ---- Header: dois modos ---- */
  /* Padrão (páginas sem hero, e home depois do scroll): branco sólido, texto escuro. */
  .site-header {
    position: sticky;
    top: 0;
    background: rgb(var(--c-surface));
    color: rgb(var(--c-ink));
    box-shadow: 0 1px 0 rgb(var(--c-rule) / 0.6);
    transition: background-color .3s ease, box-shadow .3s ease, color .3s ease;
  }
  .site-header .nav-brand { color: rgb(var(--c-ink)); }
  .site-header .nav-link { color: rgb(var(--c-ink-muted)); }
  .site-header .nav-link:hover,
  .site-header .nav-link.is-current { color: rgb(var(--c-ink)); }
  .site-header .nav-icon { color: rgb(var(--c-ink-muted)); }
  .site-header .nav-icon:hover { color: rgb(var(--c-ink)); background: rgb(var(--c-ink) / 0.06); }
  /* Logo: preto no modo sólido (padrão/scroll), branco no transparente (sobre a hero) */
  .site-header .logo-light { display: none; }
  .site-header .logo-dark { display: block; }
  .site-header[data-transparent]:not(.is-solid) .logo-light { display: block; }
  .site-header[data-transparent]:not(.is-solid) .logo-dark { display: none; }

  /* Transparente sobre a hero (home no topo). */
  .site-header[data-transparent]:not(.is-solid) {
    position: fixed;
    left: 0; right: 0;
    background: transparent;
    color: #fff;
    box-shadow: none;
  }
  .site-header[data-transparent]:not(.is-solid) .nav-brand { color: #fff; }
  .site-header[data-transparent]:not(.is-solid) .nav-link { color: rgb(255 255 255 / 0.82); }
  .site-header[data-transparent]:not(.is-solid) .nav-link:hover,
  .site-header[data-transparent]:not(.is-solid) .nav-link.is-current { color: #fff; }
  .site-header[data-transparent]:not(.is-solid) .nav-icon { color: rgb(255 255 255 / 0.82); }
  .site-header[data-transparent]:not(.is-solid) .nav-icon:hover { color: #fff; background: rgb(255 255 255 / 0.12); }

  /* Home depois do scroll: fica fixo e branco sólido. */
  .site-header[data-transparent].is-solid {
    position: fixed;
    left: 0; right: 0;
    background: rgb(var(--c-surface));
    color: rgb(var(--c-ink));
    box-shadow: 0 1px 0 rgb(var(--c-rule) / 0.6), 0 10px 30px -20px rgb(20 20 24 / 0.35);
  }

  /* Submenu aberto via clique (funciona com hover ligado ou desligado). */
  [data-submenu].is-open > .submenu-panel { opacity: 1; visibility: visible; }
</style>

<script>
  document.querySelectorAll('[data-submenu]').forEach((el) => {
    const btn = el.querySelector('[data-submenu-toggle]');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const open = el.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-submenu].is-open').forEach((el) => {
      if (!el.contains(e.target as Node)) {
        el.classList.remove('is-open');
        el.querySelector('[data-submenu-toggle]')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  // Header transparente → sólido ao rolar (só quando data-transparent está presente).
  (function () {
    const header = document.getElementById('site-header');
    if (header && header.hasAttribute('data-transparent')) {
      const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  })();
</script>

<script is:inline>
  (function() {
    const menuBtn  = document.getElementById('menu-toggle');
    const mobile   = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose= document.getElementById('menu-icon-close');
    if (menuBtn && mobile) {
      menuBtn.addEventListener('click', () => {
        const isOpen = !mobile.classList.contains('hidden');
        mobile.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!isOpen));
        iconOpen?.classList.toggle('hidden', !isOpen ? true : false);
        iconClose?.classList.toggle('hidden', !isOpen ? false : true);
      });
    }
  })();
</script>
