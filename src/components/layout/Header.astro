---
import { readData } from '../../lib/readData';
import { normalizeCategories, collectOrphanCategories, categoryMatches } from '../../lib/categorySlug';
import { getCollection } from 'astro:content';

const siteConfig = readData('siteConfig.json');
const menuItems: any[] = readData('menu.json', { items: [] }).items || [];

// CTA principal do header: SEMPRE o motor de reservas (`/#reservar` = buscador
// de datas na home), igual ao resto do site. Antes ia para o WhatsApp, o que
// criava dois funis disputando o mesmo clique.
const reservarUrl = '/#reservar';

// WhatsApp continua disponível, mas como canal de atendimento — nunca com o
// rótulo "Reservar", pra não competir com o motor.
const waNumber = (siteConfig.contact?.whatsapp || '').replace(/\D/g, '');
const waUrl = waNumber
  ? `https://wa.me/55${waNumber}?text=${encodeURIComponent('Olá! Vim pelo site e gostaria de tirar uma dúvida.')}`
  : '';

// O item "Contato" do menu deixou de ser uma pagina: virou o numero da
// recepcao, direto no WhatsApp. Sai do siteConfig, nao esta escrito a mao.
//
// O "+55" e' acrescentado AQUI, na exibicao, e nao no siteConfig: o valor de
// la tambem monta o link `wa.me/55<digitos>`, e um "+55" gravado no arquivo
// entraria duas vezes no numero (`wa.me/55 55 13...`), quebrando o link.
const waBruto = String(siteConfig.contact?.whatsapp || '').trim();
const waNumeroLegivel = waBruto && !waBruto.startsWith('+') ? `+55 ${waBruto}` : waBruto;

const posts = await getCollection('blog');
const categoriesData = readData('categories.json', []);
const registered = normalizeCategories(categoriesData);
const postCats = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const orphans = collectOrphanCategories(postCats, registered);
// Mesma regra do rodapé: submenu de tópicos só lista categoria com artigo.
const allCategories = [...registered, ...orphans].filter((cat) =>
  posts.some((p: any) => categoryMatches(p.data.category, cat))
);

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);

// transparent = header transparente sobre a hero (só onde há hero escura, ex. home).
// Ativa o modo "sólido no scroll" via JS. Sem a prop, header é sempre branco sólido.
const { transparent = false } = Astro.props;
---

<header id="site-header" class="site-header z-40" data-transparent={transparent ? 'true' : undefined}>
  <div class="container-x flex items-center justify-between h-[68px] gap-6">
    <a href="/" class="flex items-center no-underline" aria-label="Home">
      <img src="/images/logo-preto.png" alt={siteConfig.name} class="logo logo-dark w-auto" style="height: 40px" />
      <img src="/images/logo-branco.png" alt="" aria-hidden="true" class="logo logo-light w-auto" style="height: 48px" />
    </a>

    <div class="flex items-center gap-1">
      {/* CTA de reserva (com o caju): entra junto com a nav branca — o gatilho
          e' o `is-solid`, o mesmo que troca o fundo. Ate la quem ocupa a vaga
          e' o CONTATO abaixo. A faixa de aviso NAO entra nisso: quando
          entrava, o layout desalinhava. */}
      <div class="header-cta flex items-center mr-1">
        <img src="/images/caju.avif" alt="" aria-hidden="true" width="126" height="104" class="hidden sm:block h-9 md:h-[2.85rem] w-auto -mr-3 md:-mr-4 relative z-10 pointer-events-none select-none -scale-x-100 translate-x-2.5 md:translate-x-2" />
        <a
          href={reservarUrl}
          class="inline-flex items-center min-h-[38px] px-4 sm:pl-7 sm:pr-5 rounded-[200px] bg-[#cf3a23] text-white text-[13px] md:text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter] whitespace-nowrap"
        >
          Reservar
        </a>
      </div>
      {/* CONTATO: so aparece enquanto o "Reservar" NAO aparece — sao os dois
          estados da mesma vaga. Na hero e' texto puro, sem fundo, herdando a
          cor branca do header transparente; ao rolar, ele sai e entra o botao.
          Ver o bloco `.header-contato` no CSS. */}
      <a
        href={waUrl || '#'}
        target="_blank"
        rel="noopener noreferrer"
        class="header-contato items-center min-h-[38px] px-3 text-[13px] md:text-sm font-semibold no-underline whitespace-nowrap hover:opacity-75 transition-opacity"
        aria-label={`Falar com a recepção no WhatsApp: ${waNumeroLegivel}`}
      >
        {waNumeroLegivel}
      </a>
      <button id="menu-toggle" class="nav-icon w-10 h-10 flex items-center justify-center rounded" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="menu-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Backdrop do drawer -->
  <div id="mobile-backdrop" class="mobile-backdrop fixed inset-0 z-40 bg-black/45" aria-hidden="true"></div>

  <!-- Drawer lateral (desliza da direita) -->
  <aside id="mobile-menu" class="mobile-drawer fixed right-0 z-50 w-[82%] max-w-xs bg-surface shadow-2xl flex flex-col" aria-label="Menu" aria-hidden="true">
    <div class="flex items-center justify-between h-[68px] px-5 shrink-0">
      <img src="/images/logo-preto.png" alt={siteConfig.name} class="w-auto" style="height: 34px" />
      <button id="menu-close" class="w-10 h-10 -mr-2 flex items-center justify-center rounded text-ink-muted hover:text-ink hover:bg-ink/5 transition-colors" aria-label="Fechar menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <nav class="px-5 py-2 flex flex-col overflow-y-auto" aria-label="Mobile">
      {menuItems.map((item: any) => (
        <>
          {/* Item externo (hoje so o WhatsApp da recepcao) abre em nova aba e
              leva `rel` de seguranca; o resto segue navegacao interna. */}
          <a
            href={item.href}
            target={item.externo ? '_blank' : undefined}
            rel={item.externo ? 'noopener noreferrer' : undefined}
            aria-current={!item.externo && isActive(item.href) ? 'page' : undefined}
            class={`py-3 text-base ${!item.externo && isActive(item.href) ? 'text-ink font-semibold' : 'text-ink-muted'}`}
          >
            {item.label}
          </a>
          {/* Os tópicos viviam no submenu do menu inline. Com ele fora, vêm
              para cá — senão as categorias sumiriam da navegação (o rodapé
              continua listando, mas não é caminho de menu). */}
          {item.showCategories && allCategories.length > 0 && (
            <div class="flex flex-col border-l border-rule ml-1 pl-4 -mt-1 mb-1">
              {allCategories.map((cat) => (
                <a href={`/categoria/${cat.slug}`} class="py-2 text-sm text-ink-muted">{cat.name}</a>
              ))}
            </div>
          )}
        </>
      ))}
    </nav>
    <div class="mt-auto p-5 shrink-0 flex flex-col gap-2.5">
      <a
        href={reservarUrl}
        class="flex items-center justify-center min-h-[48px] px-6 rounded-[200px] bg-[#cf3a23] text-white text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]"
      >
        Reservar
      </a>
      {waUrl && (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 min-h-[44px] px-6 rounded-[200px] border border-rule text-ink text-sm font-semibold no-underline hover:bg-elev transition-colors"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm5.8 14.16c-.24.68-1.42 1.3-1.96 1.35-.5.05-1.14.07-1.83-.11-.42-.13-.97-.31-1.67-.61-2.94-1.27-4.86-4.23-5-4.43-.15-.2-1.2-1.6-1.2-3.05s.76-2.16 1.03-2.46c.27-.3.59-.37.79-.37h.57c.18 0 .43-.07.67.51.24.59.83 2.04.9 2.19.07.15.12.32.02.52-.1.2-.15.32-.3.49-.15.17-.31.38-.45.51-.15.15-.3.31-.13.61.17.3.76 1.25 1.63 2.03 1.12 1 2.06 1.31 2.36 1.46.3.15.47.12.64-.07.17-.2.74-.86.94-1.16.2-.3.39-.25.66-.15.27.1 1.71.81 2.01.96.3.15.49.22.56.34.07.12.07.71-.17 1.39z"/></svg>
          Falar no WhatsApp
        </a>
      )}
    </div>
  </aside>
</header>

<style>
  /* ---- Header: dois modos ---- */
  /* Padrão (páginas sem hero, e home depois do scroll): branco sólido, texto escuro. */
  .site-header {
    /* `sticky` em `top: 0`, sempre. O menu vem DEPOIS da faixa de campanha no
       fluxo: enquanto a pagina esta no alto ele aparece abaixo dela, e assim
       que a faixa rola embora ele gruda no topo — o navegador faz isso sozinho.
       Antes ele era `fixed` em `top: var(--campaign-h)`, e esconder a faixa
       exigia sincronizar DUAS posicoes por JS: era o que desalinhava tudo. */
    position: sticky;
    top: 0;
    background: rgb(var(--c-surface));
    color: rgb(var(--c-ink));
    box-shadow: 0 1px 0 rgb(var(--c-rule) / 0.6);
    transition: background-color .3s ease, box-shadow .3s ease, color .3s ease;
  }
  .site-header .nav-brand { color: rgb(var(--c-ink)); }
  .site-header .nav-icon { color: rgb(var(--c-ink-muted)); }
  .site-header .nav-icon:hover { color: rgb(var(--c-ink)); background: rgb(var(--c-ink) / 0.06); }
  /* Logo: preto no modo sólido (padrão/scroll), branco no transparente (sobre a hero) */
  .site-header .logo-light { display: none; }
  .site-header .logo-dark { display: block; }
  .site-header[data-transparent]:not(.is-solid) .logo-light { display: block; }
  .site-header[data-transparent]:not(.is-solid) .logo-dark { display: none; }

  /* Transparente sobre a hero (home no topo). NÃO é flutuante — `static`, no
     fluxo normal da página: sobe e desce junto com o resto do conteúdo e sai
     de tela ao rolar, como a foto atrás dele. Só a nav DEPOIS do scroll
     (`.is-solid`, logo abaixo) é que gruda no topo — a flutuante é só essa. */
  .site-header[data-transparent]:not(.is-solid) {
    position: static;
    background: transparent;
    color: #fff;
    box-shadow: none;
  }
  .site-header[data-transparent]:not(.is-solid) .nav-brand { color: #fff; }
  .site-header[data-transparent]:not(.is-solid) .nav-icon { color: rgb(255 255 255 / 0.82); }
  .site-header[data-transparent]:not(.is-solid) .nav-icon:hover { color: #fff; background: rgb(255 255 255 / 0.12); }

  /* Home depois do scroll: fica fixo e branco sólido. */
  .site-header[data-transparent].is-solid {
    position: sticky;
    top: 0;
    background: rgb(var(--c-surface));
    color: rgb(var(--c-ink));
    box-shadow: 0 1px 0 rgb(var(--c-rule) / 0.6), 0 10px 30px -20px rgb(20 20 24 / 0.35);
  }

  /* ---- CTA "Reservar" ----
     O botao (com o caju) entra no MESMO instante em que a nav fica branca —
     o gatilho e' o `is-solid`, um so para os dois, para nao haver um momento
     com a nav ja branca e a vaga do botao ainda vazia.
     Em pagina QUE TEM buscador de datas (`:has(#booking-form)`) ele nasce
     escondido: enquanto o buscador esta na tela, um "Reservar" no menu
     disputaria o mesmo clique. Em pagina SEM buscador (blog, contato,
     artigos, landings) nenhuma destas regras casa e o CTA fica visivel desde
     o topo, que e' o certo: la nao ha com que competir.
     O estado inicial vem do CSS, nao do JS, para o botao nao piscar. */
  body:has(#booking-form) .header-cta { display: none; }
  body:has(#booking-form) .site-header.is-solid .header-cta { display: flex; }

  /* CONTATO ocupa a vaga enquanto o "Reservar" esta fora, e sai quando ele
     entra — nunca os dois juntos. Em pagina SEM buscador (blog, contato,
     artigos, landings) o "Reservar" vale desde o topo, entao o CONTATO nao
     aparece ali: a regra abaixo so casa onde ha `#booking-form`. */
  .header-contato { display: none; color: inherit; }
  body:has(#booking-form) .header-contato { display: inline-flex; }
  body:has(#booking-form) .site-header.is-solid .header-contato { display: none; }

  /* Pagina com `#nav-telefone` (ex.: grupos e excursoes): o telefone fica no
     menu o tempo todo, no topo e depois do scroll, e o "Reservar" nunca entra.
     Vem depois das regras acima para vencer a especificidade igual. */
  body:has(#nav-telefone) .header-cta,
  body:has(#nav-telefone) .site-header.is-solid .header-cta { display: none; }
  body:has(#nav-telefone) .header-contato,
  body:has(#nav-telefone) .site-header.is-solid .header-contato { display: inline-flex; }

  /* ---- Drawer lateral (mobile) ---- */
  .mobile-drawer {
    /* A faixa nao e' mais fixa, entao nada cobre o topo: o drawer ocupa a
       tela inteira. */
    top: 0;
    height: 100%;
    transform: translateX(100%);
    transition: transform .32s cubic-bezier(.4, 0, .2, 1);
    will-change: transform;
  }
  .mobile-drawer.is-open { transform: translateX(0); }
  .mobile-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity .32s ease;
  }
  .mobile-backdrop.is-open { opacity: 1; pointer-events: auto; }
</style>

<script>
  /* Header transparente → sólido: o gatilho é o CARD BRANCO DO BUSCADOR
     chegando perto do menu, não o fim da hero inteira. Antes o menu SUMIA
     (transform translateY(-100%)) assim que o scroll começava e só voltava,
     já sólido, quando a hero INTEIRA tinha passado — no celular isso é ~600px
     de rolagem sem logo, sem telefone e sem menu nenhum na tela, o que lia
     como bug ("sumiu e não volta").

     Agora comparamos o TOPO do card (`#booking-form`) com a base do menu: até
     ali o menu flutua transparente sobre a foto (texto branco, legível). No
     instante em que o card começa a passar por baixo do menu, o menu já troca
     para sólido (fundo branco, texto escuro) — o card nunca fica encoberto
     por um menu transparente, e o menu nunca precisa desaparecer para isso.

     Sem `#booking-form` (nenhuma hero com buscador usa header transparente
     hoje), cai no fim da hero como antes. Sem hero na página, nada disso se
     aplica (o menu já nasce sólido). */
  (function () {
    const header = document.getElementById('site-header');
    if (!header || !header.hasAttribute('data-transparent')) return;

    const gatilho = document.getElementById('booking-form') || document.getElementById('reservar');
    let agendado = false;

    const avaliar = () => {
      agendado = false;
      const passou = gatilho
        ? gatilho.getBoundingClientRect().top <= header.offsetHeight
        : window.scrollY > 40;          // sem hero: régua antiga
      header.classList.toggle('is-solid', passou);
    };
    const aoRolar = () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(avaliar);
    };

    avaliar();
    window.addEventListener('scroll', aoRolar, { passive: true });
    window.addEventListener('resize', aoRolar, { passive: true });
  })();
</script>

<script is:inline>
  (function() {
    var menuBtn   = document.getElementById('menu-toggle');
    var closeBtn  = document.getElementById('menu-close');
    var drawer    = document.getElementById('mobile-menu');
    var backdrop  = document.getElementById('mobile-backdrop');
    var iconOpen  = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    if (!menuBtn || !drawer || !backdrop) return;

    function setIcons(open) {
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
    }
    function openMenu() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      drawer.style.transform = 'translateX(0)';
      backdrop.style.opacity = '1';
      backdrop.style.pointerEvents = 'auto';
      drawer.setAttribute('aria-hidden', 'false');
      menuBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setIcons(true);
    }
    function closeMenu() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      drawer.style.transform = '';
      backdrop.style.opacity = '';
      backdrop.style.pointerEvents = '';
      drawer.setAttribute('aria-hidden', 'true');
      menuBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setIcons(false);
    }
    function toggleMenu() {
      if (drawer.classList.contains('is-open')) closeMenu(); else openMenu();
    }

    menuBtn.addEventListener('click', toggleMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeMenu();
    });
    // Fecha ao clicar num link do menu.
    drawer.querySelectorAll('a[href]').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });
  })();
</script>
