---
// Bloco de conversão para reserva — inspirado no layout de "evento" do lifewave
// (hero dividido: conteúdo + card), adaptado à marca Cajueiro. O botão leva à
// hero da home, onde fica o buscador de datas.
import { readData } from '../lib/readData';
const siteConfig = readData('siteConfig.json');
const c = siteConfig.contact || {};
const whatsapp = c.whatsapp || '';
const waDigits = (whatsapp || '').replace(/\D/g, '');
const waUrl = waDigits ? `https://wa.me/55${waDigits}` : '';

const { title, subtitle, beneficios } = Astro.props;
const heading = title || 'Consulte datas e garanta o melhor preço';
const lead = subtitle || 'Veja a disponibilidade em tempo real e reserve direto pelo nosso site, sempre com a melhor tarifa.';
const items = (beneficios && beneficios.length ? beneficios : [
  'Melhor preço garantido pelo site',
  'A 100 metros da Praia do Tombo',
  'Café da manhã artesanal incluso',
  'Recepção 24 horas',
]);
---

<section class="relative overflow-hidden" style="background:#55703A;">
  <div aria-hidden="true" class="absolute -top-28 -left-24 w-[26rem] h-[26rem] rounded-full" style="background:rgba(255,255,255,0.06);"></div>
  <div aria-hidden="true" class="absolute -bottom-32 -right-20 w-[24rem] h-[24rem] rounded-full" style="background:rgba(0,0,0,0.10);"></div>

  <div class="container-x py-16 md:py-24 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Conteúdo -->
      <div>
        <p class="inline-flex items-center gap-2 mono uppercase mb-4" style="color:rgba(255,255,255,0.8);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Reserve sua estadia
        </p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white leading-[1.1] mb-4">{heading}</h2>
        <p class="text-lg leading-relaxed mb-7 max-w-xl" style="color:rgba(255,255,255,0.82);">{lead}</p>
        <ul class="flex flex-col gap-3">
          {items.map((f: string) => (
            <li class="flex items-center gap-3">
              <span class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="text-white/90">{f}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Card de ação -->
      <div class="bg-surface rounded-lg p-7 md:p-9 shadow-2xl lg:ml-auto w-full max-w-md">
        <h3 class="font-display text-2xl font-semibold text-ink mb-2">Comece sua reserva</h3>
        <p class="text-ink-muted leading-relaxed mb-6">Escolha as datas e o número de hóspedes no buscador e veja a disponibilidade na hora.</p>
        <a href="/" class="w-full inline-flex items-center justify-center gap-2.5 min-h-[52px] px-6 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Consultar datas
        </a>
        {waUrl && (
          <p class="text-sm text-ink-muted text-center mt-4">
            Prefere falar? <a href={waUrl} target="_blank" rel="noopener" class="font-semibold text-ink hover:text-primary transition-colors">WhatsApp {whatsapp}</a>
          </p>
        )}
      </div>
    </div>
  </div>
</section>
