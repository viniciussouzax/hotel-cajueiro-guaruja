---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmailInlineBanner from '../../plugins/email-list/EmailInlineBanner.astro';
import AffiliateProducts from '../../plugins/affiliates/AffiliateProducts.astro';
import PostSchemaPlugins from '../../plugins/_slots/PostSchemaPlugins.astro';
import PostBottomPlugins from '../../plugins/_slots/PostBottomPlugins.astro';
import PostAfterPlugins from '../../plugins/_slots/PostAfterPlugins.astro';
import PostVideo from '../../components/ui/PostVideo.astro';
import ReserveCTA from '../../components/ReserveCTA.astro';
import { getCollection } from 'astro:content';
import { readData } from '../../lib/readData';
import { normalizeCategories, getCategorySlug } from '../../lib/categorySlug';
import { parseVideoUrl } from '../../lib/videoEmbed';
import { renderShortcodes, hasShortcodes } from '../../lib/shortcodes';
const authorsData = readData('authors.json', []);
const allCategories = normalizeCategories(readData('categories.json', []));

const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const inlineConfig = pluginsConfig?.emailList?.inline;
const inlineEnabled = inlineConfig?.enabled === true;
const inlinePosition = Number(inlineConfig?.position ?? 3);

export async function getStaticPaths() {
  const siteConfig = readData('siteConfig.json', {}) as any;
  // Se aluno escolheu URL limpa (sem /blog), nao geramos /blog/X
  if (siteConfig.postUrlPrefix !== 'blog') return [];
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
const post = Astro.props;
const { Content } = await post.render();

const currentAuthor = authorsData.find((a: any) => a.id === post.data.author) || authorsData[0] || {
  name: 'Equipe',
  role: 'Redação',
  avatar: '',
  bio: ''
};

const categorySlug = post.data.category ? getCategorySlug(post.data.category, allCategories) : '';
const siteConfig = readData('siteConfig.json', {}) as any;
const postUrl = `${siteConfig.url || Astro.url.origin}/blog/${post.slug}`;

const videoUrl = post.data.videoUrl || '';
const videoInfo = videoUrl ? parseVideoUrl(videoUrl) : null;
const hasValidVideo = videoInfo && videoInfo.provider !== 'unknown';
const videoPosition = post.data.videoPosition || 'after-hero';

const rawBody = (post.body || '') as string;
const isHtmlBody = /^\s*</.test(rawBody.trim());
const processedHtml = isHtmlBody && hasShortcodes(rawBody) ? renderShortcodes(rawBody) : null;
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage} type="article">
  <PostSchemaPlugins
    title={post.data.title}
    description={post.data.description || ''}
    url={postUrl}
    image={post.data.heroImage}
    datePublished={post.data.pubDate instanceof Date ? post.data.pubDate.toISOString() : post.data.pubDate}
    authorName={currentAuthor?.name}
    category={post.data.category}
    videoUrl={hasValidVideo ? videoUrl : undefined}
  />

  <article>
    <!-- ===== Cabeçalho (coluna estreita, estilo Medium) ===== -->
    <div class="container-x pt-14 md:pt-20">
      <div class="max-w-[720px] mx-auto">
        <div class="flex items-center gap-4 mono uppercase text-ink-faint mb-6">
          <a href="/blog" class="hover:text-ink transition-colors">← Blog</a>
          {post.data.category && (
            <a href={`/categoria/${categorySlug}`} class="text-[#cf3a23] hover:brightness-90 transition">{post.data.category}</a>
          )}
        </div>
        <h1 class="font-display text-3xl md:text-5xl font-normal tracking-tight text-ink leading-[1.08] mb-5">{post.data.title}</h1>
        {post.data.description && (
          <p class="text-xl text-ink-muted leading-relaxed mb-8">{post.data.description}</p>
        )}
        <div class="flex items-center gap-3 py-4 border-t border-b border-rule">
          {currentAuthor.avatar ? (
            <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-11 h-11 rounded-full object-cover" />
          ) : (
            <div class="w-11 h-11 rounded-full bg-elev flex items-center justify-center font-semibold text-ink-faint">{currentAuthor.name.charAt(0)}</div>
          )}
          <div class="text-sm">
            <div class="font-semibold text-ink leading-tight">{currentAuthor.name}</div>
            <div class="text-ink-faint">
              {post.data.pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Imagem/vídeo de destaque ===== -->
    {hasValidVideo && videoPosition === 'hero' ? (
      <div class="container-x mt-10">
        <div class="max-w-[880px] mx-auto rounded-lg overflow-hidden">
          <PostVideo url={videoUrl} title={post.data.title} description={post.data.description} uploadDate={post.data.pubDate instanceof Date ? post.data.pubDate.toISOString() : String(post.data.pubDate)} lite={true} />
        </div>
      </div>
    ) : post.data.heroImage ? (
      <div class="container-x mt-10">
        <img src={post.data.heroImage} alt={post.data.title} class="max-w-[880px] w-full mx-auto rounded-lg object-cover" loading="eager" />
      </div>
    ) : null}

    {hasValidVideo && videoPosition === 'after-hero' && (
      <div class="container-x mt-10">
        <div class="max-w-[880px] mx-auto rounded-lg overflow-hidden">
          <PostVideo url={videoUrl} title={post.data.title} description={post.data.description} uploadDate={post.data.pubDate instanceof Date ? post.data.pubDate.toISOString() : String(post.data.pubDate)} lite={true} />
        </div>
      </div>
    )}

    <!-- ===== Corpo do artigo ===== -->
    <div class="container-x">
      <div class="post-content prose-msia max-w-[720px] mx-auto py-10 md:py-14">
        {processedHtml ? (<Fragment set:html={processedHtml} />) : (<Content />)}
      </div>
      {inlineEnabled && (
        <div id="email-inline-source" data-position={inlinePosition} style="display:none">
          <EmailInlineBanner />
        </div>
      )}
      <div class="max-w-[720px] mx-auto"><AffiliateProducts /></div>
    </div>

    <!-- ===== Compartilhar + tag ===== -->
    <div class="container-x">
      <div class="max-w-[720px] mx-auto flex items-center justify-between gap-4 flex-wrap py-6 border-t border-rule">
        {post.data.category && (
          <a href={`/categoria/${categorySlug}`} class="mono uppercase text-ink-faint hover:text-ink transition-colors">#{post.data.category}</a>
        )}
        <PostBottomPlugins title={post.data.title} />
      </div>
    </div>

    <!-- ===== Autor ===== -->
    <div class="container-x">
      <div class="max-w-[720px] mx-auto flex gap-5 items-start py-8 border-t border-rule">
        {currentAuthor.avatar ? (
          <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-16 h-16 rounded-full object-cover shrink-0" />
        ) : (
          <div class="w-16 h-16 rounded-full bg-elev flex items-center justify-center text-2xl font-semibold text-ink-faint shrink-0">{currentAuthor.name.charAt(0)}</div>
        )}
        <div>
          <h4 class="font-semibold text-ink">{currentAuthor.name}</h4>
          {currentAuthor.role && <p class="mono uppercase text-ink-faint mt-0.5">{currentAuthor.role}</p>}
          {currentAuthor.bio && <p class="text-ink-muted leading-relaxed mt-2">{currentAuthor.bio}</p>}
        </div>
      </div>
    </div>

    <!-- ===== Relacionados ===== -->
    <div class="container-x pb-10 md:pb-14">
      <div class="max-w-[1000px] mx-auto">
        <PostAfterPlugins currentSlug={post.slug} category={post.data.category || ''} />
      </div>
    </div>
  </article>

  <!-- ===== CTA de reserva ===== -->
  <ReserveCTA />

  <script is:inline>
  // Substitui &nbsp; (espaço não-quebrável do Quill) por espaços normais nos artigos já salvos
  (function() {
    var postContent = document.querySelector('.post-content');
    if (!postContent) return;
    var walker = document.createTreeWalker(postContent, NodeFilter.SHOW_TEXT, null);
    var node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue && node.nodeValue.indexOf('\u00A0') !== -1) {
        node.nodeValue = node.nodeValue.replace(/\u00A0/g, ' ');
      }
    }
  })();
  </script>

  {inlineEnabled && (
    <script>
    (function() {
      const source = document.getElementById('email-inline-source');
      if (!source) return;
      const pos = Number((source as HTMLElement).dataset.position) || 3;
      const paragraphs = document.querySelectorAll('.post-content > p');
      const target = paragraphs[pos - 1] || paragraphs[paragraphs.length - 1];
      if (target) {
        target.insertAdjacentElement('afterend', source);
        source.style.display = 'block';
      }
    })();
    </script>
  )}

</BaseLayout>
