---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const contato = readData('contato.json', {}) as any;

const c = siteConfig.contact || {};
const email = c.email || '';
const phone = contato.telefone || c.phone || '';
const whatsapp = contato.whatsapp || c.whatsapp || '';
const address = contato.endereco || c.address || '';
const horarios = contato.horarios || {};
const regiao = contato.regiao || {};

const waDigits = (whatsapp || '').replace(/\D/g, '');
const waUrl = waDigits ? `https://wa.me/55${waDigits}` : '';
const phoneHref = phone ? `tel:+55${phone.replace(/\D/g, '')}` : '';

const heroImage = '/images/hero-tombo.jpg';
const inputCls = 'w-full rounded-lg px-4 py-3 text-ink bg-bg border border-rule outline-none transition-colors focus:border-[#cf3a23] placeholder:text-ink-faint';
---

<BaseLayout title={`Contato · ${siteConfig.name}`} description={contato.intro || `Fale com ${siteConfig.name}`} transparentHeader={true}>

  <!-- ===== HERO + formulário ===== -->
  <section class="relative isolate">
    <div
      class="absolute inset-0 -z-10 bg-cover bg-center"
      style={`background-image: linear-gradient(180deg, rgba(38,51,28,.45), rgba(38,51,28,.7)), url('${heroImage}')`}
    ></div>

    <div class="container-x pt-28 md:pt-36 pb-16 md:pb-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Texto -->
        <div class="lg:pt-6">
          <p class="mono uppercase text-white/80 mb-5">( contato )</p>
          <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight text-white leading-[1.03] mb-6">
            {contato.intro || 'Fale com a gente'}
          </h1>
          <p class="text-lg md:text-xl leading-relaxed max-w-lg" style="color:rgba(255,255,255,0.88);">
            Tem uma dúvida sobre sua reserva, o hotel ou o Guarujá? Escreve pra gente que a recepção responde rápido, todos os dias.
          </p>
        </div>

        <!-- Card do formulário -->
        <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-2xl">
          <form class="space-y-5" action="/api/subscribe" method="POST">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-medium text-ink mb-1.5" for="name">Nome</label>
                <input type="text" id="name" name="name" required placeholder="Seu nome" class={inputCls} />
              </div>
              <div>
                <label class="block text-sm font-medium text-ink mb-1.5" for="whatsapp">WhatsApp</label>
                <input type="tel" id="whatsapp" name="whatsapp" placeholder="(13) 90000-0000" class={inputCls} />
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5" for="email">E-mail</label>
              <input type="email" id="email" name="email" required placeholder="voce@email.com" class={inputCls} />
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1.5" for="message">Mensagem</label>
              <textarea id="message" name="message" rows="5" required placeholder="Como podemos ajudar?" class={`${inputCls} resize-y`}></textarea>
            </div>
            <button type="submit" class="w-full inline-flex items-center justify-center min-h-[52px] px-8 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">
              Enviar mensagem
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
