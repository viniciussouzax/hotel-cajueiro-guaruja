---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const contato = readData('contato.json', {}) as any;

const c = siteConfig.contact || {};
const email = c.email || '';
const phone = contato.telefone || c.phone || '';
const whatsapp = contato.whatsapp || c.whatsapp || '';
const address = contato.endereco || c.address || '';
const horarios = contato.horarios || {};
const regiao = contato.regiao || {};
const form = contato.form || {};

const waDigits = (whatsapp || '').replace(/\D/g, '');
const waUrl = waDigits ? `https://wa.me/55${waDigits}` : '';
const phoneHref = phone ? `tel:+55${phone.replace(/\D/g, '')}` : '';
---

<BaseLayout title={`Contato · ${siteConfig.name}`} description={contato.intro || `Fale com ${siteConfig.name}`}>
  <section>
    <div class="container-x pt-16 md:pt-20 pb-12">
      <p class="mono uppercase text-ink-faint mb-5">contato</p>
      <h1 class="font-display text-3xl md:text-5xl font-normal tracking-tight text-ink leading-[1.05] mb-6 max-w-3xl">
        {contato.intro || 'Teremos prazer em tirar todas as suas dúvidas!'}
      </h1>
    </div>
  </section>

  <div class="container-x py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-12 md:gap-20">
      <div class="space-y-8">
        {phone && (
          <div>
            <div class="mono uppercase text-ink-faint mb-2">telefone</div>
            <a href={phoneHref} class="text-lg font-medium text-ink hover:text-primary transition-colors">{phone}</a>
          </div>
        )}
        {waUrl && (
          <div>
            <div class="mono uppercase text-ink-faint mb-2">whatsapp</div>
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-lg font-medium text-ink hover:text-primary transition-colors">{whatsapp}</a>
          </div>
        )}
        {email && (
          <div>
            <div class="mono uppercase text-ink-faint mb-2">email</div>
            <a href={`mailto:${email}`} class="text-lg font-medium text-ink hover:text-primary transition-colors">{email}</a>
          </div>
        )}
        {address && (
          <div>
            <div class="mono uppercase text-ink-faint mb-2">endereço</div>
            <p class="text-base text-ink leading-relaxed">{address}</p>
          </div>
        )}
        {(horarios.atendimentoExterno || horarios.recepcao) && (
          <div>
            <div class="mono uppercase text-ink-faint mb-2">horários</div>
            {horarios.atendimentoExterno && <p class="text-base text-ink leading-relaxed">{horarios.atendimentoExterno}</p>}
            {horarios.recepcao && <p class="text-base text-ink leading-relaxed">{horarios.recepcao}</p>}
          </div>
        )}
      </div>

      <form class="space-y-6" action="/api/subscribe" method="POST">
        <div>
          <label class="mono uppercase text-ink-faint block mb-2" for="name">nome</label>
          <input type="text" id="name" name="name" required class="w-full bg-transparent border-b border-rule focus:border-ink py-2 text-ink outline-none transition-colors" />
        </div>
        <div>
          <label class="mono uppercase text-ink-faint block mb-2" for="email">email</label>
          <input type="email" id="email" name="email" required class="w-full bg-transparent border-b border-rule focus:border-ink py-2 text-ink outline-none transition-colors" />
        </div>
        <div>
          <label class="mono uppercase text-ink-faint block mb-2" for="message">mensagem</label>
          <textarea id="message" name="message" rows="5" required class="w-full bg-transparent border-b border-rule focus:border-ink py-2 text-ink outline-none transition-colors resize-y"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">
          enviar
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </form>
    </div>

    {(regiao.titulo || regiao.texto) && (
      <div class="mt-16 md:mt-24 border-t border-rule pt-12 max-w-2xl">
        <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{regiao.titulo}</h2>
        {regiao.texto && <p class="text-lg text-ink-muted leading-relaxed">{regiao.texto}</p>}
      </div>
    )}
  </div>
</BaseLayout>
