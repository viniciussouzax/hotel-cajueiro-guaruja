---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostVideo from '../components/ui/PostVideo.astro';
import { getCollection } from 'astro:content';
import { readData } from '../lib/readData';
import { colorForCategory } from '../lib/categoryColors';
import { normalizeCategories, getCategorySlug } from '../lib/categorySlug';
import { parseVideoUrl } from '../lib/videoEmbed';
import { renderShortcodes, hasShortcodes } from '../lib/shortcodes';
import EmailInlineBanner from '../plugins/email-list/EmailInlineBanner.astro';
import AffiliateProducts from '../plugins/affiliates/AffiliateProducts.astro';
import PostSchemaPlugins from '../plugins/_slots/PostSchemaPlugins.astro';
import PostBottomPlugins from '../plugins/_slots/PostBottomPlugins.astro';

const allCategories = normalizeCategories(readData('categories.json', []));

export async function getStaticPaths() {
  const siteConfig = readData('siteConfig.json', {}) as any;
  // Quando aluno escolheu prefixo /blog, esta rota nao gera (evita duplicacao com /blog/[slug]).
  if (siteConfig?.postUrlPrefix === 'blog') return [];
  const posts = await getCollection('blog');
  return posts.map((post: any) => ({
    params: { slug: post.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const data = post.data;

const siteConfig = readData('siteConfig.json');
const authorsData = readData('authors.json', []) as any[];
const currentAuthor = authorsData.find((a: any) => a.id === data.author) || authorsData[0] || { name: 'Equipe' };
const postUrl = `${siteConfig.url || Astro.url.origin}/${post.slug ?? post.id}`;

// Plugins (e-mail inline + posts relacionados) — config compartilhada com /blog/[slug].
const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const inlineConfig = pluginsConfig?.emailList?.inline;
const inlineEnabled = inlineConfig?.enabled === true;
const inlinePosition = Number(inlineConfig?.position ?? 3);
const relCfg = pluginsConfig?.relatedPosts || {};
const relEnabled = relCfg.enabled !== false;
const relCount = Number(relCfg.count ?? 3);

const catColor = colorForCategory(data.category);

// WhatsApp para o card de reserva na lateral do artigo.
const waDigits = (siteConfig.contact?.whatsapp || '').replace(/\D/g, '');
const waUrl = waDigits ? `https://wa.me/55${waDigits}` : '';

function fmtDate(d: any): string {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return '';
  return dt.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: '2-digit' });
}

const readingMinutes = (() => {
  try {
    const text = (post.body || '') as string;
    const words = text.split(/\s+/).length;
    return Math.max(1, Math.round(words / 200));
  } catch { return 5; }
})();

// Próximos posts (mesma categoria, depois outros)
const allPosts = await getCollection('blog');
const otherPosts = allPosts.filter((p: any) => (p.slug ?? p.id) !== (post.slug ?? post.id));
// Respeita a config do plugin "Posts Relacionados" (ligar/desligar, quantidade),
// priorizando a mesma categoria.
const sameCat = data.category ? otherPosts.filter((p: any) => p.data.category === data.category) : [];
const related = relEnabled
  ? [...sameCat, ...otherPosts.filter((p: any) => !sameCat.includes(p))].slice(0, relCount)
  : [];

const videoUrl = data.videoUrl || '';
const videoInfo = videoUrl ? parseVideoUrl(videoUrl) : null;
const hasValidVideo = videoInfo && videoInfo.provider !== 'unknown';
const videoPosition = data.videoPosition || 'after-hero';

// Processa shortcodes [[video:URL]] no body (e quaisquer outros suportados).
// Só roda quando body já é HTML (Quill output); pra .md puro o Astro Content cuida.
const rawBody = (post.body || '') as string;
const isHtmlBody = /^\s*</.test(rawBody.trim());
const processedHtml = isHtmlBody && hasShortcodes(rawBody) ? renderShortcodes(rawBody) : null;
---

<BaseLayout
  title={data.title}
  description={data.description || ''}
  image={data.heroImage || data.cover || ''}
  type="article"
>
  <PostSchemaPlugins
    title={data.title}
    description={data.description || ''}
    url={postUrl}
    image={data.heroImage || data.cover || ''}
    datePublished={(data.pubDate || data.date) instanceof Date ? (data.pubDate || data.date).toISOString() : String(data.pubDate || data.date || '')}
    authorName={currentAuthor?.name}
    category={data.category}
    videoUrl={hasValidVideo ? videoUrl : undefined}
  />

  <article class="container-x pt-14 md:pt-20 pb-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">

      <!-- ===== CTA de reserva: sticky à direita no desktop; no mobile aparece no fim (foto perto do footer) ===== -->
      <aside class="lg:col-span-4 lg:col-start-9 lg:row-start-1">
        <div class="lg:sticky lg:top-24 rounded-lg overflow-hidden relative">
          <img src="/images/suite-2.jpg" alt="Suíte do Hotel Cajueiro" loading="lazy" class="w-full h-40 object-cover" />
          <div class="p-6 md:p-7 relative overflow-hidden" style="background:#55703A;">
            <div aria-hidden="true" class="absolute -top-16 -right-12 w-48 h-48 rounded-full" style="background:rgba(255,255,255,0.07);"></div>
            <div class="relative">
              <h3 class="font-display text-2xl font-semibold text-white leading-[1.15] mb-4">Reserve sua suíte no Hotel Cajueiro</h3>
              <ul class="flex flex-col gap-2.5 mb-6">
                {['A 100m da Praia do Tombo', 'Café da manhã artesanal', 'Melhor preço pelo site'].map((f) => (
                  <li class="flex items-center gap-2.5 text-sm text-white/90">
                    <span class="shrink-0 w-5 h-5 rounded-full flex items-center justify-center" style="background:rgba(255,255,255,0.15);">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
              <a href="/" class="w-full inline-flex items-center justify-center gap-2 min-h-[48px] px-5 rounded-[200px] bg-[#cf3a23] text-bg text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                Consultar datas
              </a>
              {waUrl && (
                <p class="text-xs text-center mt-4" style="color:rgba(255,255,255,0.75);">
                  Prefere falar? <a href={waUrl} target="_blank" rel="noopener" class="font-semibold text-white underline underline-offset-2">WhatsApp</a>
                </p>
              )}
            </div>
          </div>
        </div>
      </aside>

      <!-- ===== Artigo (cabeçalho + imagem + conteúdo): coluna 1, 8/12 ===== -->
      <div class="lg:col-span-8 lg:col-start-1 lg:row-start-1 min-w-0">
        <!-- Breadcrumb: início / categoria / leitura atual -->
        <nav class="mono uppercase text-ink-faint text-xs mb-8 flex items-center gap-2.5 flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="hover:text-ink transition-colors">início</a>
          <span class="opacity-40">/</span>
          {data.category && (
            <>
              <a href={`/categoria/${getCategorySlug(data.category, allCategories)}`} class="hover:text-ink transition-colors">{data.category}</a>
              <span class="opacity-40">/</span>
            </>
          )}
          <span class="text-ink">leitura atual</span>
        </nav>
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{data.title}</h1>
        {data.description && (
          <p class="text-lg md:text-xl text-ink-muted leading-relaxed mb-8">{data.description}</p>
        )}
        <div class="mono uppercase text-ink-faint text-xs flex items-center gap-2.5 flex-wrap">
          {data.category && (<><span>{data.category}</span><span class="opacity-40">·</span></>)}
          <span>{fmtDate(data.pubDate || data.date)}</span>
          <span class="opacity-40">·</span>
          <span>{readingMinutes} min de leitura</span>
          <span class="opacity-40">·</span>
          <span>por {currentAuthor.name}</span>
        </div>

        <!-- Imagem/vídeo de destaque -->
        {hasValidVideo && videoPosition === 'hero' ? (
          <div class="rounded-lg overflow-hidden mt-8 md:mt-10">
            <PostVideo url={videoUrl} title={data.title} description={data.description} uploadDate={(data.pubDate || data.date) instanceof Date ? (data.pubDate || data.date).toISOString() : String(data.pubDate || data.date || '')} lite={true} />
          </div>
        ) : (data.heroImage || data.cover || data.coverImage) ? (
          <img src={data.heroImage || data.cover || data.coverImage} alt={data.title} class="w-full max-h-[420px] rounded-lg object-cover mt-8 md:mt-10" loading="eager" />
        ) : null}

        {hasValidVideo && videoPosition === 'after-hero' && (
          <div class="rounded-lg overflow-hidden mt-8 md:mt-10">
            <PostVideo url={videoUrl} title={data.title} description={data.description} uploadDate={(data.pubDate || data.date) instanceof Date ? (data.pubDate || data.date).toISOString() : String(data.pubDate || data.date || '')} lite={true} />
          </div>
        )}

        <!-- Corpo -->
        <div class="prose-msia max-w-none mt-8 md:mt-10">
          {processedHtml ? (<Fragment set:html={processedHtml} />) : (<Content />)}
        </div>

        <!-- CTA inline: caixa clara compacta distribuída no corpo (via JS) -->
        <div id="inline-reserve-source" style="display:none">
          <div class="my-6 rounded-lg px-5 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3 md:gap-5" style="background:#DCE4CC;">
            <p class="text-base text-ink-muted leading-snug md:flex-1 min-w-0" style="margin:0">
              <span class="inline-block w-2 h-2 rounded-full align-middle mr-2" style="background:#cf3a23;"></span><strong class="font-semibold text-ink">Reserve sua suíte no Hotel Cajueiro</strong> pelo melhor preço, direto pelo nosso site.
            </p>
            <a href="/" class="shrink-0 self-start md:self-auto inline-flex items-center bg-[#cf3a23] text-sm font-semibold px-5 py-2.5 rounded-full hover:brightness-95 transition-[filter]" style="color:#fff; text-decoration:none">Consultar datas</a>
          </div>
        </div>

        {inlineEnabled && (
          <div id="email-inline-source" data-position={inlinePosition} style="display:none">
            <EmailInlineBanner />
          </div>
        )}
        <AffiliateProducts />
        <div class="flex items-center justify-between gap-4 flex-wrap py-6 mt-8 border-t border-rule">
          {data.category && (
            <a href={`/categoria/${getCategorySlug(data.category, allCategories)}`} class="mono uppercase text-ink-faint hover:text-ink transition-colors">#{data.category}</a>
          )}
          <PostBottomPlugins title={data.title} />
        </div>
        {(currentAuthor.bio || currentAuthor.role) && (
          <div class="flex gap-5 items-start py-8 border-t border-rule">
            {currentAuthor.avatar ? (
              <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-16 h-16 rounded-full object-cover shrink-0" />
            ) : (
              <div class="w-16 h-16 rounded-full bg-elev flex items-center justify-center text-2xl font-semibold text-ink-faint shrink-0">{currentAuthor.name.charAt(0)}</div>
            )}
            <div>
              <h4 class="font-semibold text-ink">{currentAuthor.name}</h4>
              {currentAuthor.role && <p class="mono uppercase text-ink-faint mt-0.5">{currentAuthor.role}</p>}
              {currentAuthor.bio && <p class="text-ink-muted leading-relaxed mt-2">{currentAuthor.bio}</p>}
            </div>
          </div>
        )}

        <!-- CTA grande de reserva (posição pós-FAQ) -->
        <section class="mt-12 rounded-xl p-8 md:p-10 text-center" style="background:#DCE4CC;">
          <p class="inline-flex items-center gap-2 mono uppercase text-[#cf3a23] mb-4">
            <span class="w-2 h-2 rounded-full" style="background:#cf3a23;"></span>
            Reserva online
          </p>
          <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink leading-[1.15] mb-4">Reserve sua suíte no Hotel Cajueiro</h2>
          <p class="text-ink-muted leading-relaxed max-w-xl mx-auto mb-7">A 100 metros da Praia do Tombo, com piscina, café da manhã artesanal e o melhor preço direto pelo nosso site. Escolha as datas e veja a disponibilidade na hora.</p>
          <a href="/" class="inline-flex items-center justify-center gap-2 min-h-[52px] px-8 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Consultar datas →
          </a>
        </section>
      </div>

    </div>
  </article>

  <!-- BLOCOS RELACIONADOS -->
    {related.length > 0 && (
      <section class="">
        <div class="container-x py-14 md:py-20">
          <p class="mono uppercase text-ink-faint mb-8">continuar lendo</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
            {related.map((p: any, i: number) => {
              const c = colorForCategory(p.data.category, i);
              const s = p.slug ?? p.id;
              return (
                <a href={`/${s}`} class={`color-block color-block-md bg-cat-${c} group`}>
                  <span class="color-block-num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="mono uppercase opacity-80 mb-3">{p.data.category}</p>
                    <h3 class="font-display text-xl md:text-2xl font-bold leading-[1.1] tracking-tight">
                      {p.data.title}
                    </h3>
                  </div>
                  <span class="mono uppercase mt-4 inline-flex items-center gap-2 self-start border-b border-current pb-1 group-hover:gap-3 transition-all">
                    abrir
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

  <!-- Distribui a CTA inline a cada N <h2> do corpo (fallback: meio dos parágrafos) -->
  <script is:inline>
    (function () {
      var src = document.getElementById('inline-reserve-source');
      if (!src) return;
      var inner = src.firstElementChild;
      if (!inner) { if (src.parentNode) src.parentNode.removeChild(src); return; }
      inner.style.display = '';
      var h2s = document.querySelectorAll('.prose-msia > h2');
      var EVERY = 3;
      if (h2s.length >= 2) {
        for (var i = EVERY; i < h2s.length; i += EVERY) {
          h2s[i].parentNode.insertBefore(inner.cloneNode(true), h2s[i]);
        }
      } else {
        var paras = document.querySelectorAll('.prose-msia > p');
        if (paras.length) {
          var t = paras[Math.floor(paras.length / 2)] || paras[paras.length - 1];
          t.insertAdjacentElement('afterend', inner.cloneNode(true));
        }
      }
      if (src.parentNode) src.parentNode.removeChild(src);
    })();
  </script>

  {inlineEnabled && (
    <script>
    (function() {
      const source = document.getElementById('email-inline-source');
      if (!source) return;
      const pos = Number((source as HTMLElement).dataset.position) || 3;
      const paragraphs = document.querySelectorAll('.prose-msia > p');
      const target = paragraphs[pos - 1] || paragraphs[paragraphs.length - 1];
      if (target) {
        target.insertAdjacentElement('afterend', source);
        (source as HTMLElement).style.display = 'block';
      }
    })();
    </script>
  )}
</BaseLayout>
