---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const suites = readData('suites.json', {}) as any;

const hero = suites.hero || {};
const amenidades = suites.amenidades || [];
const quartos = suites.quartos || [];
---

<BaseLayout title={`Suítes · ${siteConfig.name}`} description={hero.lead || 'Suítes confortáveis e modernas no Hotel Cajueiro Guarujá.'}>

  <!-- ===== HERO ===== -->
  <section>
    <div class="container-x pt-16 md:pt-24 pb-12 md:pb-16">
      {hero.eyebrow && <p class="mono uppercase text-ink-faint mb-5">{hero.eyebrow}</p>}
      <h1 class="font-display text-4xl md:text-6xl font-normal tracking-tight text-ink leading-[1.05] max-w-3xl mb-6">{hero.title}</h1>
      {hero.lead && <p class="text-lg md:text-xl text-ink-muted leading-relaxed max-w-2xl">{hero.lead}</p>}

      {amenidades.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-8 mono uppercase text-ink-faint">
          {amenidades.map((a: string) => <li>· {a}</li>)}
        </ul>
      )}
    </div>
  </section>

  <!-- ===== QUARTOS ===== -->
  <section class="border-t border-rule">
    <div class="container-x py-14 md:py-20 space-y-16 md:space-y-24">
      {quartos.map((q: any, i: number) => (
        <article class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
          <!-- Imagem (placeholder para o design) -->
          <div class={`md:col-span-6 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
            <div class="w-full aspect-[4/3] bg-elev border border-rule rounded flex items-center justify-center">
              <p class="mono uppercase text-ink-faint">foto do quarto</p>
            </div>
          </div>
          <!-- Texto -->
          <div class={`md:col-span-6 ${i % 2 === 1 ? 'md:order-1' : ''}`}>
            {q.local && <p class="mono uppercase text-ink-faint mb-3">{q.local}</p>}
            <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{q.nome}</h2>
            {q.descricao && <div class="text-lg text-ink-muted leading-relaxed space-y-4 mb-5">{q.descricao.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
            {q.capacidade && <p class="mono uppercase text-ink-faint mb-6">{q.capacidade}</p>}
            {q.cta && <a href="#reservar" class="inline-block bg-ink text-bg rounded px-6 py-3 font-semibold hover:opacity-90 transition">{q.cta}</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
