---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');

// Contato para grupos (usa o contato geral do hotel).
const gEmail = siteConfig.contact?.email || 'contato@hotelcajueiroguaruja.com.br';
const waDigits = (siteConfig.contact?.whatsapp || '(13) 99143-9331').replace(/\D/g, '');
const waFull = waDigits.length >= 11 ? `55${waDigits}` : waDigits;
const waMsg = encodeURIComponent('Olá! Quero uma proposta de hospedagem para grupo/excursão no Hotel Cajueiro (Guarujá).');
const waUrl = `https://wa.me/${waFull}?text=${waMsg}`;
const endereco = 'Rua Avedis Simonian, 1177 - Guaiuba/Tombo, Guarujá/SP';
const mapQuery = encodeURIComponent('Hotel Cajueiro Guarujá ' + endereco);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const diferenciais = [
  { icon: 'tag', title: 'Tarifas especiais para grupos', text: 'Condições e valores diferenciados conforme o número de quartos e o período da estadia. Quanto maior o grupo, melhor a proposta.' },
  { icon: 'coffee', title: 'Café da manhã incluso', text: 'Café da manhã artesanal incluso para todo o grupo, com a opção de incluir jantar em meia pensão ou pensão completa.' },
  { icon: 'pin', title: 'A 100 m da praia', text: 'A uma quadra da Praia do Tombo, com fácil acesso pelos dois lados do porto e vagas para carros na propriedade.' },
];

const perfis = [
  { title: 'Excursões e agências', text: 'Para operadoras e agências que organizam bate-volta e roteiros pelo litoral, com uma base confortável e bem localizada para o grupo se hospedar no Guarujá.', tag: 'Operadoras e guias' },
  { title: 'Grupos de amigos e família', text: 'Para aquela viagem grande, com várias famílias ou amigos juntos. Montamos as suítes próximas umas das outras para todo mundo ficar por perto.', tag: 'Viagem em grupo' },
  { title: 'Confraternizações e eventos', text: 'Para formaturas, grupos de igreja, terceira idade, times e confraternizações que buscam hospedagem em conjunto, com estrutura e conforto para todos.', tag: 'Grupos e turmas' },
];

const suites = [
  { nome: 'Suíte com varanda', img: '/images/corp-2.jpg', desc: 'Cama de casal e uma varanda exclusiva, para quem prefere mais espaço e um ambiente para relaxar ao fim do dia.' },
  { nome: 'Suíte casal', img: '/images/corp-3.jpg', desc: 'Cama de casal em um ambiente aconchegante, ideal para uma estadia confortável e uma boa noite de sono.' },
  { nome: 'Suíte dupla', img: '/images/corp-4.jpg', desc: 'Duas camas de solteiro, prática e confortável para quem viaja acompanhado.' },
  { nome: 'Suíte dupla com varanda', img: '/images/corp-5.jpg', desc: 'Duas camas de solteiro com a vantagem de uma varanda exclusiva, para relaxar ao ar livre.' },
  { nome: 'Suíte tripla', img: '/images/corp-6.jpg', desc: 'Três camas em um ambiente amplo, ideal para acomodar mais gente junta com todo o conforto.' },
];

const amenities = [
  'Café da manhã completo', 'Jantar (meia ou pensão completa)', 'Piscina com bar', 'Wi-Fi',
  'Ar-condicionado', 'Frigobar', 'Vagas rotativas para carros na propriedade', 'Vagas gratuitas na rua em frente ao hotel',
  'Suítes com ou sem varanda', 'Guarda-roupas', 'Enxoval hoteleiro', 'Recepção 24h',
  'Limpeza diária', 'A 100 m da Praia do Tombo',
];

const galeria = [
  { img: '/images/corp-7.jpg', alt: 'Piscina', big: true },
  { img: '/images/corp-8.jpg', alt: 'Café da manhã completo' },
  { img: '/images/corp-9.jpg', alt: 'Acomodação confortável' },
  { img: '/images/corp-10.jpg', alt: 'Espaço do café da manhã', wide: true },
  { img: '/images/corp-11.jpg', alt: 'Praia do Tombo' },
  { img: '/images/corp-12.jpg', alt: 'Suíte com varanda' },
  { img: '/images/corp-13.jpg', alt: 'Quartos para grupos', wide: true },
];

const ICON: Record<string, string> = {
  tag: '<path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><line x1="7" y1="7" x2="7.01" y2="7"/>',
  coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4.5"/><line x1="10" y1="2" x2="10" y2="4.5"/><line x1="14" y1="2" x2="14" y2="4.5"/>',
  pin: '<path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
};

const ctaBtn = 'inline-flex items-center justify-center min-h-[52px] px-8 rounded-[200px] bg-[#cf3a23] text-white text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]';
---

<BaseLayout title="Grupos e Excursões" description="Hospedagem para grupos e excursões no Hotel Cajueiro, a 100 metros da Praia do Tombo no Guarujá. Tarifas especiais, café da manhã incluso e suítes próximas para o grupo todo.">

  <!-- ===== HERO ===== -->
  <section>
    <div class="container-x pt-16 md:pt-24 pb-12 md:pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <p class="mono uppercase text-primary mb-4">A 100m da Praia do Tombo</p>
          <h1 class="font-display text-4xl md:text-5xl xl:text-6xl font-semibold tracking-tight text-ink leading-[1.05] mb-6">
            Hospedagem para grupos e excursões no Guarujá
          </h1>
          <p class="text-lg text-ink-muted leading-relaxed max-w-xl mb-8">
            Traga o seu grupo para descansar a uma quadra da praia. Tarifas especiais por número de quartos, café da manhã incluso, suítes próximas umas das outras e toda a estrutura para a turma aproveitar junta.
          </p>
          <a href={waUrl} target="_blank" rel="noopener" class={ctaBtn}>Falar com consultor</a>
          <p class="mt-4 text-sm text-ink-faint">Prefere e-mail? <a href={`mailto:${gEmail}`} class="text-ink underline-offset-2 hover:text-primary">{gEmail}</a></p>
        </div>
        <div class="relative">
          <img src="/images/corp-1.jpg" alt="Hotel Cajueiro, hospedagem para grupos no Guarujá" class="w-full rounded-2xl object-cover aspect-[4/3] shadow-xl" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DIFERENCIAIS ===== -->
  <section class="bg-elev">
    <div class="container-x py-14 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-10">
        {diferenciais.map((d) => (
          <div class="flex items-start gap-4">
            <span class="shrink-0 w-11 h-11 rounded-full bg-surface flex items-center justify-center text-primary">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={ICON[d.icon]} />
            </span>
            <div>
              <h3 class="font-display text-xl font-semibold text-ink mb-1.5">{d.title}</h3>
              <p class="text-ink-muted leading-relaxed">{d.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PARA QUEM É ===== -->
  <section>
    <div class="container-x py-16 md:py-24">
      <div class="max-w-2xl mb-10 md:mb-14">
        <p class="mono uppercase text-primary mb-3">para quem é</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-ink leading-tight mb-4">O grupo todo bem acomodado</h2>
        <p class="text-lg text-ink-muted leading-relaxed">O Hotel Cajueiro recebe grupos de todos os tipos, das excursões de agência às viagens em família e confraternizações, com a estrutura e o conforto para todos aproveitarem juntos.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {perfis.map((p) => (
          <div class="bg-surface rounded-2xl border border-rule/60 p-7 flex flex-col">
            <h3 class="font-display text-xl font-semibold text-ink mb-3">{p.title}</h3>
            <p class="text-ink-muted leading-relaxed flex-1">{p.text}</p>
            <span class="mono uppercase text-xs text-primary mt-5">{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ACOMODAÇÕES ===== -->
  <section class="bg-elev">
    <div class="container-x py-16 md:py-24">
      <div class="max-w-2xl mb-10 md:mb-14">
        <p class="mono uppercase text-primary mb-3">Acomodações</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-ink leading-tight mb-4">62 suítes para acomodar o seu grupo</h2>
        <p class="text-lg text-ink-muted leading-relaxed">Todas as acomodações têm ar-condicionado, enxoval completo, Wi-Fi e frigobar. Montamos a configuração ideal para o grupo, com suítes de casal a tripla e próximas umas das outras.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {suites.map((s) => (
          <div class="bg-surface rounded-2xl border border-rule/60 overflow-hidden flex flex-col">
            <img src={s.img} alt={s.nome} class="w-full aspect-[4/3] object-cover" />
            <div class="p-6">
              <h3 class="font-display text-lg font-semibold text-ink mb-2">{s.nome}</h3>
              <p class="text-ink-muted leading-relaxed text-[15px]">{s.desc}</p>
            </div>
          </div>
        ))}
        <div class="rounded-2xl p-7 flex flex-col justify-center" style="background:#26331C; color:#F4EEDD;">
          <h3 class="font-display text-xl font-semibold mb-3">Configuração para o grupo</h3>
          <p class="leading-relaxed mb-6" style="color:rgba(244,238,221,0.85);">Montamos as suítes conforme o seu grupo: casais, duplas ou triplas, próximas umas das outras. Diga quantas pessoas e o período, e cuidamos do resto.</p>
          <a href={waUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-[200px] bg-[#cf3a23] text-white text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter] self-start">Falar com consultor</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ESTRUTURA ===== -->
  <section>
    <div class="container-x py-16 md:py-24">
      <div class="max-w-2xl mb-10 md:mb-14">
        <p class="mono uppercase text-primary mb-3">estrutura</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-ink leading-tight mb-4">O que o hotel oferece</h2>
        <p class="text-lg text-ink-muted leading-relaxed">Tudo o que o grupo precisa para uma estadia tranquila e confortável, do café da manhã artesanal à recepção 24 horas.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {amenities.map((a) => (
          <div class="flex items-center gap-3 bg-elev rounded-xl px-4 py-3.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary shrink-0" set:html={ICON.check} />
            <span class="text-ink text-[15px] font-medium">{a}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== GALERIA ===== -->
  <section class="bg-elev">
    <div class="container-x py-16 md:py-24">
      <div class="max-w-2xl mb-10 md:mb-14">
        <p class="mono uppercase text-primary mb-3">Galeria</p>
        <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-ink leading-tight mb-4">Fotos</h2>
        <p class="text-lg text-ink-muted leading-relaxed">Conforto, praticidade e atenção aos detalhes em cada ambiente.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[150px] md:auto-rows-[190px] gap-3">
        {galeria.map((g) => (
          <div class={`overflow-hidden rounded-xl ${g.big ? 'col-span-2 row-span-2' : ''} ${g.wide ? 'col-span-2' : ''}`}>
            <img src={g.img} alt={g.alt} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== COMO CHEGAR ===== -->
  <section>
    <div class="container-x py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div>
          <p class="mono uppercase text-primary mb-3">Como chegar</p>
          <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-ink leading-tight mb-5">Fácil acesso, pelos dois lados do porto</h2>
          <p class="text-ink-muted mb-6">{endereco}</p>
          <div class="space-y-5">
            <div>
              <h3 class="font-semibold text-ink mb-1">De Santos (Margem Direita)</h3>
              <p class="text-ink-muted text-[15px]">Balsa pela Ponta da Praia (cerca de 7 minutos, 24h) ou pela Rodovia Cônego Domênico Rangoni.</p>
            </div>
            <div>
              <h3 class="font-semibold text-ink mb-1">De São Paulo</h3>
              <p class="text-ink-muted text-[15px]">Pelas rodovias Anchieta ou Imigrantes até a Baixada Santista, seguindo para o Guarujá.</p>
            </div>
            <div>
              <h3 class="font-semibold text-ink mb-1">Vagas para carros</h3>
              <p class="text-ink-muted text-[15px]">Rotativas na propriedade e gratuitas na rua em frente ao hotel.</p>
            </div>
          </div>
          <a href={mapHref} target="_blank" rel="noopener" class="mt-7 inline-flex items-center justify-center min-h-[44px] px-6 rounded-[200px] bg-[#26331C] text-[#F4EEDD] text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-110 transition-[filter]">Ver no mapa</a>
        </div>
        <div class="rounded-2xl overflow-hidden border border-rule/60 aspect-[4/3] lg:aspect-auto lg:h-full min-h-[320px]">
          <iframe src={mapEmbed} title="Mapa do Hotel Cajueiro" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full h-full" style="border:0;"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA FINAL ===== -->
  <section style="background:#55703A;">
    <div class="container-x py-16 md:py-24 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-semibold tracking-tight text-white leading-tight mb-4">Peça a proposta para o seu grupo</h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto" style="color:rgba(255,255,255,0.85);">Conte quantas pessoas, as datas e se precisa de jantar. Enviamos uma cotação sob medida, sem compromisso.</p>
      <a href={waUrl} target="_blank" rel="noopener" class={ctaBtn}>Falar com consultor</a>
      <p class="mt-4 text-sm" style="color:rgba(255,255,255,0.75);">Prefere e-mail? <a href={`mailto:${gEmail}`} class="text-white hover:underline">{gEmail}</a></p>
    </div>
  </section>

</BaseLayout>
