---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaFinal from '../components/CtaFinal.astro';
import BookingBar from '../components/BookingBar.astro';
import HotelSchema from '../components/layout/HotelSchema.astro';
import GoogleReviews from '../components/sections/GoogleReviews.astro';
import GoogleRating from '../components/GoogleRating.astro';
import SuitesDestaque from '../components/sections/SuitesDestaque.astro';
import TextoFoto from '../components/sections/TextoFoto.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const home = readData('home.json', {}) as any;

const hero = home.hero || {};
const heroImage = hero.image || '';
const booking = hero.booking || {};
// `hero.banner` (o painel "Temporada 2026") deixou de ser renderizado: a campanha
// agora vive so' na barra acima do menu, e este espaco passou a ser da prova
// social. O dado continua em home.json, intacto, caso se queira de volta.
const features = home.features || [];
const intro = home.intro || {};
const localizacao = home.localizacao || {};
const diferenciais = home.diferenciais || {};
const depoimentos = home.depoimentos || [];
const cta = home.cta || {};
// `home.faq` continua no JSON, intacto, mas a home nao renderiza mais a FAQ:
// as duvidas viram materia de blog (ver PENDENCIAS-CONTEUDO.md).
const comoChegar = home.comoChegar || {};
const estrutura = home.estrutura || {};
const galeria = home.galeria || {};
const entorno = home.entorno || {};
// `home.modalidades` continua no JSON, intacto, mas a home nao renderiza mais
// a secao "Viaja a trabalho ou em grupo?" (ver PENDENCIAS-CONTEUDO.md).

// Ícones de linha (Lucide) para as comodidades da seção Estrutura.
const AICON: Record<string, string> = {
  coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4.5"/><line x1="10" y1="2" x2="10" y2="4.5"/><line x1="14" y1="2" x2="14" y2="4.5"/>',
  dinner: '<path d="M5 3v6a2 2 0 1 0 4 0V3"/><line x1="7" y1="9" x2="7" y2="21"/><path d="M17 3v18"/><path d="M17 3c-1.7 0-3 1.9-3 4.5S15.3 12 17 12"/>',
  pool: '<path d="M2 16c1.5 0 1.5-1.5 3-1.5s1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5"/><path d="M2 11c1.5 0 1.5-1.5 3-1.5s1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5"/>',
  wifi: '<path d="M2 8.8a15 15 0 0 1 20 0"/><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 16a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>',
  laptop: '<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>',
  parking: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 17V7h3.5a3 3 0 0 1 0 6H9"/>',
  ac: '<line x1="12" y1="2" x2="12" y2="22"/><line x1="4" y1="6.5" x2="20" y2="17.5"/><line x1="20" y1="6.5" x2="4" y2="17.5"/>',
  fridge: '<rect x="5.5" y="2.5" width="13" height="19" rx="2"/><line x1="5.5" y1="10" x2="18.5" y2="10"/><line x1="8.5" y1="6" x2="8.5" y2="7.5"/><line x1="8.5" y1="13" x2="8.5" y2="15"/>',
  bed: '<path d="M2 4v16"/><path d="M2 9h16a3 3 0 0 1 3 3v8"/><path d="M2 16h19"/><path d="M6 9V6h6v3"/>',
  closet: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  linen: '<rect x="3" y="6.5" width="18" height="4.5" rx="1.2"/><rect x="3" y="13" width="18" height="4.5" rx="1.2"/><line x1="7" y1="6.5" x2="7" y2="11"/><line x1="7" y1="13" x2="7" y2="17.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>',
  clean: '<path d="m12 3 1.7 4.8L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7L12 3Z"/><path d="M18.5 14.5v3M17 16h3"/>',
  waves: '<path d="M2 6c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  beach: '<path d="M12 21a9 9 0 0 0 9-9H3a9 9 0 0 0 9 9Z"/><path d="M12 3v9"/><path d="M8 6a8 8 0 0 1 8 0"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  flag: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>',
  aid: '<path d="M11 2a2 2 0 0 0-2 2v5H4a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h5v5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-5h5a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-5V4a2 2 0 0 0-2-2z"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  default: '<polyline points="20 6 9 17 4 12"/>',
};

const endereco = comoChegar.endereco || (siteConfig.contact?.address || '');
const mapQuery = encodeURIComponent('Hotel Cajueiro Guarujá ' + endereco);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<BaseLayout description={siteConfig.description} transparentHeader={true} hideTopBars={true}>

  <HotelSchema />

  <!-- ===== HERO estilo Trip.com: imagem + headline + barra de busca + banner sobreposto ===== -->
  <!-- id="reservar": todo CTA de reserva do site aponta pra cá, onde fica o buscador
       de datas ligado ao motor de reservas. Antes apontava pro CTA do rodapé. -->
  {/* `-mt-[68px]`: o menu agora e' `sticky` e ocupa lugar no fluxo. A hero sobe
      por baixo dele para o modo transparente sobre a foto continuar existindo —
      sem isto ela comecaria 68px abaixo e ficaria uma faixa vazia no topo. */}
  <section id="reservar" class="relative scroll-mt-[68px] -mt-[68px]">
    <!-- Fundo: foto (se houver), ou gradiente oceânico -->
    <div
      class="hero-fundo absolute inset-0 -z-10 bg-cover bg-bottom"
      {/* Veu azul-oceano sobre a foto, nas mesmas opacidades de antes (.45 no
          topo, .7 na base). O 22,52,79 e' o `#16344f` que ja servia de fundo
          alternativo desta mesma hero — azul escuro da propria paleta, nao uma
          cor nova. O veu verde-oliva anterior esverdeava o mar da foto. */}
      style={heroImage
        ? `background-image: linear-gradient(180deg, rgba(22,52,79,.45), rgba(22,52,79,.7)), url('${heroImage}')`
        : 'background-image: linear-gradient(155deg, #16344f 0%, #235a80 48%, #3d86ac 100%)'}
    ></div>

    {/* A hero e' puxada 68px para cima (`-mt-[68px]`) para deslizar sob o menu
        transparente. Por isso o RECUO SUPERIOR tem de ser maior que os 68px do
        menu — senao o conteudo fica atras dele. Foi o que aconteceu quando o
        celular caiu para 56px: 12px do texto ficavam cobertos.
        Agora: 68px do menu + 44px de respiro = 112px no celular, o que da ~50px
        entre a base do menu e a nota do Google. No desktop os 112px ja
        folgavam. Mexer aqui exige refazer essa conta.
        O recuo INFERIOR do celular acompanha (56px): com 28px o buscador
        encostava na borda da foto, e o respiro de cima e o de baixo ficavam
        visivelmente desiguais. */}
    <div class="container-x pt-28 pb-14 md:pb-[144px]">
      {/* Nota do Google acima do texto: prova social no primeiro olhar, antes
          mesmo do título. Some sozinha se a Places API não responder. */}
      <GoogleRating tone="light" class="mb-5" />
      {hero.eyebrow && <p class="mono uppercase text-white/75 mb-4">{hero.eyebrow}</p>}
      {/* Mesmo tamanho do h1 das outras páginas (corporativo, grupos):
          text-3xl → md:text-4xl → lg:text-[48px]. Antes usava um `clamp()`
          próprio que rendia menor que as outras páginas em boa parte das
          larguras — duas réguas de tamanho para o mesmo elemento (h1 de
          hero) no site. */}
      <h1 class="font-display text-3xl md:text-4xl lg:text-[48px] font-bold tracking-tight text-white leading-[1.05] mb-4">
        {hero.title}
      </h1>
      {hero.lead && <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl mb-6 md:mb-9">{hero.lead}</p>}

      <BookingBar />
    </div>

  </section>

  <style>
    /* CELULAR: mostrar a PARTE DE BAIXO da foto (agua e coqueiros), nao o topo
       (ceu e horizonte), que passava por tras do menu.

       Por que precisa de zoom: a hero e' retrato (375x553) e a foto e' 16:9.
       Com `cover` ela e' escalada pela altura e cabe EXATAMENTE — nao sobra
       nada em cima para cortar, e por isso trocar `bottom` por `top` nao
       movia um pixel. Renderizando a 120% da altura, sobram 20% que saem pelo
       TOPO, porque a ancora e' o rodape.

       A proporcao e' preservada (`auto` na largura): a imagem e' aproximada,
       nunca distorcida. Para mostrar mais ou menos ceu, mexa so no 120%. */
    @media (max-width: 767px) {
      .hero-fundo {
        background-size: cover, auto 120%;
        background-position: center, 50% 100%;
      }
    }
  </style>

  {/* Três suítes em cartão, subindo 30% por cima da foto da hero. O respiro
      de 300px até a próxima seção é prop do componente. */}
  <SuitesDestaque />

  <!-- ===== AVALIAÇÕES DO GOOGLE (slider) =====
       Substitui a antiga seção de depoimentos manuais. Sem chave da Places API,
       com erro, ou com zero avaliações, o componente se remove sozinho — a home
       não fica com buraco nem com esqueleto vazio. -->
  <GoogleReviews bg="bg-elev" />

  <!-- ===== ESTRUTURA (o que o hotel oferece) ===== -->
  {estrutura.itens && estrutura.itens.length > 0 && (
    <section id="estrutura" class=" scroll-mt-24">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-10 md:mb-12">
          {estrutura.eyebrow && <p class="mono uppercase text-[#cf3a23] mb-3">{estrutura.eyebrow}</p>}
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{estrutura.title}</h2>
          {estrutura.text && <p class="text-lg text-ink-muted leading-relaxed">{estrutura.text}</p>}
        </div>
        <!-- flex-wrap + justify-center: com 14 itens a grade de 4 colunas deixava a
             última fila com 2 itens e um vão grande à direita. Assim a última fila
             fica centrada, do mesmo tamanho das outras. -->
        <ul class="flex flex-wrap justify-center gap-4 list-none p-0 m-0">
          {estrutura.itens.map((a: any) => (
            <li class="flex items-center gap-3.5 bg-surface rounded-md px-5 py-4 border border-rule/40 shadow-[0_1px_2px_rgba(60,45,25,.06)] basis-full sm:basis-[calc(50%-0.5rem)] lg:basis-[calc(25%-0.75rem)] grow-0">
              <svg class="w-5 h-5 shrink-0 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={AICON[a.icon] || AICON.default}></svg>
              <span class="text-sm font-medium text-ink leading-snug">{a.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===== 3 FEATURES (icone + texto) ===== -->
  {features.length > 0 && (
    <section class="">
      <div class="container-x py-14 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {features.map((f: any) => (
            <div class="flex items-start gap-4">
              <span class="shrink-0 w-12 h-12 rounded-[20px] bg-cat-terracota/10 flex items-center justify-center">
                <svg class="w-6 h-6 text-cat-terracota" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={AICON[f.icon] || AICON.default}></svg>
              </span>
              <div>
                <h3 class="font-sans font-semibold text-lg text-ink mb-2">{f.title}</h3>
                <p class="text-base text-ink-muted leading-relaxed">{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== GALERIA (mesmo padrão de Corporativo e Grupos) ===== -->
  {galeria.fotos && galeria.fotos.length > 0 && (
    <section class="bg-elev">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-10 md:mb-12">
          {galeria.eyebrow && <p class="mono uppercase text-[#cf3a23] mb-3">{galeria.eyebrow}</p>}
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{galeria.title}</h2>
          {galeria.text && <p class="text-lg text-ink-muted leading-relaxed">{galeria.text}</p>}
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[150px] md:auto-rows-[200px] gap-3.5">
          {galeria.fotos.map((g: any, i: number) => (
            <button
              type="button"
              data-gallery-open={i}
              aria-label={`Ampliar foto: ${g.cap}`}
              class={`group block m-0 p-0 border-0 bg-transparent cursor-pointer rounded-md overflow-hidden shadow-[0_18px_40px_-28px_rgba(60,45,25,.5)] ${g.cls}`}
            >
              <img
                src={`/images/corp-${g.n}.jpg`}
                alt={g.cap}
                loading="lazy"
                class={`w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 ${(g.n === 10 || g.n === 13) ? 'object-bottom' : ''}`}
              />
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== O HOTEL E A LOCALIZAÇÃO =====
       Fundo CREME, o mesmo de "Como chegar" logo abaixo: os dois formam um
       bloco visual só (quatro texto+foto alternando lado). Trocar a cor de um
       sem o outro cria uma emenda no meio da série. E creme aqui é o que faz o
       CTA final, em areia, contrastar — por isso a alternância foi montada de
       trás para frente, com o CTA como âncora. =====
       Blocos de texto + foto usando o MESMO componente (TextoFoto), com o lado
       da imagem alternando. Com "Como chegar" logo abaixo, a sequência é
       direita → esquerda → direita. O primeiro é sobre o hotel (era a antiga
       seção "intro", que tinha duas colunas de texto e deixava metade da tela
       vazia). O bloco da piscina foi removido; ao mexer aqui, conferir que a
       alternância continua fechando, incluindo o "Como chegar". -->
  <section class="">
    {/* Sem recuo INFERIOR: a secao seguinte ("Como chegar") ja traz o
        proprio `py-16 md:py-24`, e os dois somavam 192px — mais que o
        dobro dos 96px que separam os blocos aqui dentro. O ritmo entre
        secoes passa a ser o mesmo do ritmo interno. */}
    <div class="container-x pt-16 md:pt-24 space-y-16 md:space-y-24">

      {(intro.title || intro.text) && (
        <TextoFoto
          title={intro.title}
          paragraphs={(intro.text || '').split('\n\n').filter(Boolean)}
          image="/images/corp-1.jpg"
          alt="Fachada do Hotel Cajueiro, na Praia do Tombo, Guarujá"
          lado="direita"
        />
      )}

      {(localizacao.title || localizacao.text) && (
        <TextoFoto
          title={localizacao.title}
          paragraphs={(localizacao.text || '').split('\n\n').filter(Boolean)}
          image="/images/hero-tombo.jpg"
          alt="Praia do Tombo vista do alto, no Guarujá"
          lado="esquerda"
        />
      )}

    </div>
  </section>

  {/* "Como chegar" entra no MESMO ritmo dos tres blocos acima: e' o proprio
      TextoFoto, com o mapa no slot `midia` no lugar da foto. Por isso herda
      proporcao, raio, borda e a alternancia de lado sem duplicar geometria.
      Os tres acima vao direita -> esquerda -> direita, entao este fecha em
      ESQUERDA, continuando o zigue-zague. O endereco, a lista de acessos e o
      botao do mapa entram pelo slot de conteudo da coluna de texto. */}
  {(comoChegar.title || endereco) && (
    <section id="como-chegar" class=" scroll-mt-24">
      <div class="container-x py-16 md:py-24">
        <TextoFoto
          eyebrow={comoChegar.eyebrow}
          title={comoChegar.title}
          lado="direita"
        >
          <iframe
            slot="midia"
            src={mapEmbed}
            title="Como chegar ao Hotel Cajueiro Guarujá"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full block aspect-[4/3] lg:aspect-[3/2]"
            style="border:0;"
          ></iframe>

          {endereco && (
            <div class="flex gap-2.5 items-start mb-6">
              <svg class="w-5 h-5 mt-0.5 shrink-0 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span class="text-[15px] leading-relaxed text-ink">{endereco}</span>
            </div>
          )}

          <div class="flex flex-col gap-4 mb-7">
            {(comoChegar.acessos || []).map((r: any) => (
              <div class="flex gap-3.5 items-start">
                <span class="shrink-0 w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(207,58,35,0.10);">
                  <svg class="w-5 h-5 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
                <div>
                  <div class="text-[15px] font-semibold text-ink">{r.titulo}</div>
                  <div class="text-sm text-ink-muted leading-relaxed">{r.texto}</div>
                </div>
              </div>
            ))}
          </div>

          <a href={mapHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 min-h-[44px] px-6 rounded-[200px] bg-[#26331C] text-[#F4EEDD] text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-110 transition-[filter]">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Ver no mapa
          </a>
        </TextoFoto>
      </div>
    </section>
  )}

  <!-- ===== LIGHTBOX DA GALERIA ===== -->
  <div id="gallery-lightbox" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/90 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Visualizador de imagens">
    <button type="button" id="gallery-close" aria-label="Fechar" class="absolute top-4 right-4 w-11 h-11 inline-flex items-center justify-center rounded-[20px] bg-white/10 text-white hover:bg-white/20 transition-colors">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button type="button" id="gallery-prev" aria-label="Imagem anterior" class="absolute left-3 md:left-6 w-12 h-12 inline-flex items-center justify-center rounded-[20px] bg-white/10 text-white hover:bg-white/20 transition-colors">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <img id="gallery-img" alt="" class="max-h-[88vh] max-w-[92vw] object-contain rounded-md shadow-2xl select-none" />
    <button type="button" id="gallery-next" aria-label="Próxima imagem" class="absolute right-3 md:right-6 w-12 h-12 inline-flex items-center justify-center rounded-[20px] bg-white/10 text-white hover:bg-white/20 transition-colors">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <span id="gallery-counter" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-white/80 text-sm font-medium"></span>
  </div>


  <!-- ===== CTA FINAL (componente padrão, igual em todas as páginas) ===== -->
  <CtaFinal />

  <script is:inline>
    (function () {
      // ---- Lightbox da galeria ----
      var lb = document.getElementById('gallery-lightbox');
      if (lb) {
        var imgEl = document.getElementById('gallery-img');
        var counter = document.getElementById('gallery-counter');
        var btns = Array.prototype.slice.call(document.querySelectorAll('[data-gallery-open]'));
        if (btns.length) {
          var srcs = btns.map(function (b) { var im = b.querySelector('img'); return im ? im.getAttribute('src') : ''; });
          var alts = btns.map(function (b) { var im = b.querySelector('img'); return im ? (im.getAttribute('alt') || '') : ''; });
          var idx = 0;
          var render = function () { imgEl.setAttribute('src', srcs[idx]); imgEl.setAttribute('alt', alts[idx]); if (counter) counter.textContent = (idx + 1) + ' / ' + srcs.length; };
          var showImg = function (i) { idx = (i + srcs.length) % srcs.length; render(); };
          var openAt = function (i) { showImg(i); lb.classList.remove('hidden'); lb.classList.add('flex'); document.body.style.overflow = 'hidden'; };
          var closeLb = function () { lb.classList.add('hidden'); lb.classList.remove('flex'); document.body.style.overflow = ''; };
          btns.forEach(function (b, i) { b.addEventListener('click', function () { openAt(i); }); });
          var p = document.getElementById('gallery-prev'), n = document.getElementById('gallery-next'), c = document.getElementById('gallery-close');
          if (p) p.addEventListener('click', function (e) { e.stopPropagation(); showImg(idx - 1); });
          if (n) n.addEventListener('click', function (e) { e.stopPropagation(); showImg(idx + 1); });
          if (c) c.addEventListener('click', closeLb);
          lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
          document.addEventListener('keydown', function (e) {
            if (lb.classList.contains('hidden')) return;
            if (e.key === 'Escape') closeLb();
            else if (e.key === 'ArrowLeft') showImg(idx - 1);
            else if (e.key === 'ArrowRight') showImg(idx + 1);
          });
          var sx = null;
          lb.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
          lb.addEventListener('touchend', function (e) { if (sx === null) return; var dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) showImg(dx < 0 ? idx + 1 : idx - 1); sx = null; }, { passive: true });
        }
      }
    })();
  </script>

</BaseLayout>

<style>
  /* Esconde o ícone nativo do date picker — usamos só o ícone de calendário à esquerda.
     O clique na área toda abre o picker (via showPicker no JS).
     :global pra atravessar o escopo do Astro e atingir o pseudo nativo. */
  :global(.booking-date::-webkit-calendar-picker-indicator) { display: none; }
  .booking-date { cursor: pointer; }
  /* Remove a setinha default do select no Safari/Chrome pra ficar mais limpo */
  .booking-bar select { appearance: none; -webkit-appearance: none; }
</style>
