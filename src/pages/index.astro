---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const home = readData('home.json', {}) as any;

const hero = home.hero || {};
const booking = hero.booking || {};
const banner = hero.banner || {};
const heroImage = hero.image || '';
const features = home.features || [];
const intro = home.intro || {};
const suitesTeaser = home.suitesTeaser || {};
const piscina = home.piscina || {};
const localizacao = home.localizacao || {};
const diferenciais = home.diferenciais || {};
const depoimentos = home.depoimentos || [];
const cta = home.cta || {};
const faq = home.faq || [];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} transparentHeader={true}>

  <!-- ===== HERO estilo Trip.com: imagem + headline + barra de busca + banner sobreposto ===== -->
  <section class="relative isolate">
    <!-- Fundo: foto (se houver) com overlay, ou gradiente oceânico -->
    <div
      class="absolute inset-0 -z-10 bg-cover bg-center"
      style={heroImage
        ? `background-image: linear-gradient(180deg, rgba(15,33,55,.35), rgba(15,33,55,.68)), url('${heroImage}')`
        : 'background-image: linear-gradient(155deg, #16344f 0%, #235a80 48%, #3d86ac 100%)'}
    ></div>

    <div class="container-x pt-28 md:pt-36 pb-20 md:pb-[212px]">
      {hero.eyebrow && <p class="mono uppercase text-white/75 mb-4">{hero.eyebrow}</p>}
      <h1 class="font-display text-4xl md:text-6xl font-semibold tracking-tight text-white leading-[1.03] max-w-3xl mb-4">
        {hero.title}
      </h1>
      {hero.lead && <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl mb-9">{hero.lead}</p>}

      <!-- Barra de busca horizontal -->
      <form
        id="booking-form"
        data-engine={booking.engineUrl}
        data-company={booking.companyId}
        data-newtab={booking.openInNewTab ? '1' : '0'}
        class="booking-bar bg-surface rounded-lg shadow-2xl p-2 flex flex-col gap-1 w-full"
      >
       <div class="flex flex-col lg:flex-row lg:items-stretch gap-1 lg:gap-0 w-full">
        <!-- Check-in -->
        <label for="checkin" class="flex items-center gap-3 flex-1 px-4 py-2.5 rounded-md hover:bg-elev transition cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span class="flex flex-col w-full">
            <span class="mono uppercase text-ink-faint text-xs">{booking.labelCheckin}</span>
            <input id="checkin" type="date" class="booking-date bg-transparent outline-none text-ink font-medium w-full" aria-label={booking.labelCheckin} />
          </span>
        </label>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Check-out -->
        <label for="checkout" class="flex items-center gap-3 flex-1 px-4 py-2.5 rounded-md hover:bg-elev transition cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span class="flex flex-col w-full">
            <span class="mono uppercase text-ink-faint text-xs">{booking.labelCheckout}</span>
            <input id="checkout" type="date" class="booking-date bg-transparent outline-none text-ink font-medium w-full" aria-label={booking.labelCheckout} />
          </span>
        </label>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Adultos -->
        <label for="adultos" class="flex items-center gap-3 flex-1 px-4 py-2.5 rounded-md hover:bg-elev transition cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          <span class="flex flex-col w-full">
            <span class="mono uppercase text-ink-faint text-xs">{booking.labelAdultos}</span>
            <select id="adultos" class="bg-transparent outline-none text-ink font-medium w-full cursor-pointer -ml-0.5" aria-label={booking.labelAdultos}>
              <option value="1">1 adulto</option>
              <option value="2" selected>2 adultos</option>
              <option value="3">3 adultos</option>
              <option value="4">4 adultos</option>
              <option value="5">5 adultos</option>
              <option value="6">6 adultos</option>
            </select>
          </span>
        </label>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Crianças -->
        <label for="criancas" class="flex items-center gap-3 flex-1 px-4 py-2.5 rounded-md hover:bg-elev transition cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><circle cx="12" cy="6" r="3"/><path d="M9 22v-6l-1.5-2A2 2 0 019.4 11h5.2a2 2 0 011.9 3l-1.5 2v6"/></svg>
          <span class="flex flex-col w-full">
            <span class="mono uppercase text-ink-faint text-xs">{booking.labelCriancas}</span>
            <select id="criancas" class="bg-transparent outline-none text-ink font-medium w-full cursor-pointer -ml-0.5" aria-label={booking.labelCriancas}>
              <option value="0" selected>Nenhuma criança</option>
              <option value="1">1 criança</option>
              <option value="2">2 crianças</option>
              <option value="3">3 crianças</option>
            </select>
          </span>
        </label>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Código promocional -->
        <label for="cupom" class="flex items-center gap-3 flex-1 px-4 py-2.5 rounded-md hover:bg-elev transition cursor-text">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span class="flex flex-col w-full">
            <span class="mono uppercase text-ink-faint text-xs">{booking.labelCupom}</span>
            <input id="cupom" type="text" placeholder={booking.placeholderCupom} class="bg-transparent outline-none text-ink font-medium w-full placeholder:text-ink-faint placeholder:font-normal" aria-label={booking.labelCupom} />
          </span>
        </label>
        <!-- Buscar -->
        <button type="submit" class="flex items-center justify-center gap-2 bg-primary text-white font-semibold rounded-md px-8 py-3.5 lg:my-0 mt-1 hover:opacity-90 transition shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {booking.cta}
        </button>
       </div>

        <!-- Idades das crianças (aparecem conforme a quantidade selecionada) -->
        <div id="children-ages" class="hidden flex-wrap items-center gap-3 px-4 pt-2 pb-1 border-t border-rule/50">
          <span class="mono uppercase text-ink-faint text-xs">Idade das crianças</span>
        </div>
      </form>
      <script is:inline>
        (function () {
          var form = document.getElementById('booking-form');
          var ci = document.getElementById('checkin');
          var co = document.getElementById('checkout');
          if (!form || !ci || !co) return;

          // yyyy-mm-dd (input date) -> Date / formatos
          var iso = function (d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          };
          // yyyy-mm-dd -> dd/mm/yyyy (formato que o motor hbook espera)
          var toBR = function (v) {
            var p = (v || '').split('-');
            return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : '';
          };

          // Pré-preenche: check-in amanhã, check-out depois de amanhã (1 diária).
          var today = new Date(); today.setHours(0, 0, 0, 0);
          var next = new Date(today); next.setDate(today.getDate() + 1);
          var after = new Date(today); after.setDate(today.getDate() + 2);
          ci.min = iso(today); ci.value = iso(next);
          co.min = iso(after); co.value = iso(after);

          // Check-out sempre depois do check-in.
          ci.addEventListener('change', function () {
            var c = new Date(ci.value + 'T00:00:00');
            var minOut = new Date(c); minOut.setDate(c.getDate() + 1);
            co.min = iso(minOut);
            if (new Date(co.value + 'T00:00:00') <= c) co.value = iso(minOut);
          });

          // ---- Idade das crianças: renderiza N selects (0–17) conforme a quantidade ----
          var criancasSel = document.getElementById('criancas');
          var agesBox = document.getElementById('children-ages');
          function renderAges() {
            if (!criancasSel || !agesBox) return;
            var n = parseInt(criancasSel.value, 10) || 0;
            agesBox.querySelectorAll('label.child-age-item').forEach(function (el) { el.remove(); });
            for (var i = 0; i < n; i++) {
              var wrap = document.createElement('label');
              wrap.className = 'child-age-item flex items-center gap-2 text-sm text-ink';
              var lbl = document.createElement('span');
              lbl.className = 'text-ink-muted';
              lbl.textContent = 'Criança ' + (i + 1) + ':';
              var sel = document.createElement('select');
              sel.className = 'child-age bg-transparent border border-rule rounded px-2 py-1 text-ink font-medium cursor-pointer';
              sel.setAttribute('aria-label', 'Idade da criança ' + (i + 1));
              for (var age = 0; age <= 17; age++) {
                var opt = document.createElement('option');
                opt.value = String(age);
                opt.textContent = age === 0 ? 'menos de 1 ano' : age + (age === 1 ? ' ano' : ' anos');
                if (age === 8) opt.selected = true;
                sel.appendChild(opt);
              }
              wrap.appendChild(lbl); wrap.appendChild(sel);
              agesBox.appendChild(wrap);
            }
            agesBox.classList.toggle('hidden', n === 0);
            agesBox.classList.toggle('flex', n > 0);
          }
          if (criancasSel) criancasSel.addEventListener('change', renderAges);

          // Ao buscar: monta a URL do motor de reservas com os parâmetros.
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var base = form.getAttribute('data-engine') || '';
            var company = form.getAttribute('data-company') || '';
            var adultos = (document.getElementById('adultos') || {}).value || '2';
            var criancas = (document.getElementById('criancas') || {}).value || '0';
            var cupom = ((document.getElementById('cupom') || {}).value || '').trim();

            var params = new URLSearchParams();
            if (company) params.set('companyId', company);
            params.set('checkin', toBR(ci.value));
            params.set('checkout', toBR(co.value));
            params.set('adults', adultos);
            params.set('children', criancas);
            // uma idade por criança: childrenage repetido (childrenage=15&childrenage=17...)
            if (agesBox) {
              agesBox.querySelectorAll('select.child-age').forEach(function (s) {
                params.append('childrenage', s.value);
              });
            }
            if (cupom) params.set('promocode', cupom);

            // URLSearchParams codifica "/" como %2F; o motor aceita a barra crua,
            // então repõe pra ficar igual ao link nativo (dd/mm/aaaa).
            var query = params.toString().replace(/%2F/gi, '/');
            var url = base + '?' + query;

            if (form.getAttribute('data-newtab') === '1') {
              window.open(url, '_blank', 'noopener');
            } else {
              window.location.href = url;
            }
          });
        })();
      </script>
    </div>

  </section>

  <!-- ===== BANNER (abaixo da hero) ===== -->
  {(banner.title || banner.text) && (
    <section class="border-t border-rule">
      <div class="container-x py-12 md:py-16">
        <div class="bg-elev rounded-lg border border-rule/60 p-6 md:p-10 flex flex-col md:flex-row md:items-center gap-6 md:gap-10">
          <div class="flex-1">
            {banner.eyebrow && <p class="mono uppercase text-primary mb-3">{banner.eyebrow}</p>}
            <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight text-ink leading-[1.15] mb-3">{banner.title}</h2>
            {banner.text && <p class="text-base md:text-lg text-ink-muted leading-relaxed max-w-2xl">{banner.text}</p>}
          </div>
          {banner.cta && <a href="#reservar" class="shrink-0 inline-flex items-center justify-center bg-primary text-white rounded-md px-7 py-4 font-semibold hover:opacity-90 transition">{banner.cta}</a>}
        </div>
      </div>
    </section>
  )}

  <!-- ===== 3 FEATURES (icone + texto) ===== -->
  {features.length > 0 && (
    <section class="border-t border-rule">
      <div class="container-x py-14 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {features.map((f: any) => (
            <div>
              <div class="w-11 h-11 rounded border border-rule flex items-center justify-center mb-4 text-ink" aria-hidden="true">
                <span class="mono uppercase text-ink-faint text-xs">{f.icon}</span>
              </div>
              <h3 class="font-sans font-semibold text-lg text-ink mb-2">{f.title}</h3>
              <p class="text-base text-ink-muted leading-relaxed">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== INTRO ===== -->
  {(intro.title || intro.text) && (
    <section class="border-t border-rule">
      <div class="container-x py-16 md:py-24">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
          <div class="md:col-span-5">
            <h2 class="font-display text-2xl md:text-3xl font-normal leading-[1.1] tracking-tight text-ink">{intro.title}</h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            {intro.text && <div class="text-lg text-ink-muted leading-relaxed space-y-4">{intro.text.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===== ACOMODAÇÕES (teaser) ===== -->
  {(suitesTeaser.title || suitesTeaser.text) && (
    <section class="border-t border-rule">
      <div class="container-x py-16 md:py-24">
        {suitesTeaser.eyebrow && <p class="mono uppercase text-ink-faint mb-4">{suitesTeaser.eyebrow}</p>}
        <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] max-w-2xl mb-6">{suitesTeaser.title}</h2>
        {suitesTeaser.text && <div class="text-lg text-ink-muted leading-relaxed max-w-2xl space-y-4 mb-8">{suitesTeaser.text.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
        {suitesTeaser.cta && <a href="/suites" class="inline-block border border-ink text-ink rounded px-6 py-3 font-semibold hover:bg-ink hover:text-bg transition">{suitesTeaser.cta}</a>}
      </div>
    </section>
  )}

  <!-- ===== PISCINA + LOCALIZAÇÃO ===== -->
  <section class="border-t border-rule">
    <div class="container-x py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      {(piscina.title || piscina.text) && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{piscina.title}</h2>
          {piscina.text && <p class="text-lg text-ink-muted leading-relaxed mb-6">{piscina.text}</p>}
          {piscina.cta && <a href="/hotel" class="mono uppercase text-ink-faint hover:text-ink transition">{piscina.cta} →</a>}
        </div>
      )}
      {(localizacao.title || localizacao.text) && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{localizacao.title}</h2>
          {localizacao.text && <div class="text-lg text-ink-muted leading-relaxed space-y-4">{localizacao.text.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
        </div>
      )}
    </div>
  </section>

  <!-- ===== DIFERENCIAIS ===== -->
  {diferenciais.items && diferenciais.items.length > 0 && (
    <section class="border-t border-rule">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-12">
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{diferenciais.title}</h2>
          {diferenciais.subtitle && <p class="text-lg text-ink-muted leading-relaxed mb-6">{diferenciais.subtitle}</p>}
          {diferenciais.cta && <a href="#reservar" class="inline-block bg-ink text-bg rounded px-6 py-3 font-semibold hover:opacity-90 transition">{diferenciais.cta}</a>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {diferenciais.items.map((it: any) => (
            <div class="border-t border-rule pt-5">
              <h3 class="font-sans font-semibold text-lg text-ink mb-2">{it.title}</h3>
              <p class="text-base text-ink-muted leading-relaxed">{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== DEPOIMENTOS ===== -->
  {depoimentos.length > 0 && (
    <section class="border-t border-rule">
      <div class="container-x py-16 md:py-24">
        {depoimentos.map((d: any) => (
          <figure class="max-w-3xl">
            <blockquote class="font-display text-2xl md:text-3xl font-normal text-ink leading-[1.25] mb-6">"{d.text}"</blockquote>
            <figcaption class="mono uppercase text-ink-faint">— {d.author}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ===== FAQ ===== -->
  {faq.length > 0 && (
    <section class="border-t border-rule">
      <div class="container-x py-16 md:py-24">
        <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-10">Perguntas frequentes</h2>
        <div class="max-w-3xl divide-y divide-rule border-t border-rule">
          {faq.map((item: any) => (
            <details class="group py-5">
              <summary class="cursor-pointer font-sans font-semibold text-lg text-ink list-none flex justify-between items-center">
                {item.q}
                <span class="text-ink-faint group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
              </summary>
              <p class="text-base text-ink-muted leading-relaxed mt-3">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== CTA FINAL ===== -->
  {(cta.title || cta.button) && (
    <section id="reservar" class="border-t border-rule">
      <div class="container-x py-20 md:py-28 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-normal tracking-tight text-ink leading-[1.05] max-w-3xl mx-auto mb-5">{cta.title}</h2>
        {cta.subtitle && <p class="text-lg text-ink-muted leading-relaxed max-w-2xl mx-auto mb-8">{cta.subtitle}</p>}
        {cta.button && <a href="/contato" class="inline-block bg-ink text-bg rounded px-8 py-4 font-semibold text-lg hover:opacity-90 transition">{cta.button}</a>}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* Ícone nativo do date picker discreto e alinhado à paleta */
  .booking-date::-webkit-calendar-picker-indicator { opacity: 0.45; cursor: pointer; }
  .booking-date::-webkit-calendar-picker-indicator:hover { opacity: 0.85; }
  /* Remove a setinha default do select no Safari/Chrome pra ficar mais limpo */
  .booking-bar select { appearance: none; -webkit-appearance: none; }
</style>
