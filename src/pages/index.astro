---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const home = readData('home.json', {}) as any;

const hero = home.hero || {};
const booking = hero.booking || {};
const banner = hero.banner || {};
const heroImage = hero.image || '';
const features = home.features || [];
const intro = home.intro || {};
const suitesTeaser = home.suitesTeaser || {};
const piscina = home.piscina || {};
const localizacao = home.localizacao || {};
const diferenciais = home.diferenciais || {};
const depoimentos = home.depoimentos || [];
const cta = home.cta || {};
const faq = home.faq || [];
const comoChegar = home.comoChegar || {};
const estrutura = home.estrutura || {};

// Ícones de linha (Lucide) para as comodidades da seção Estrutura.
const AICON: Record<string, string> = {
  coffee: '<path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4.5"/><line x1="10" y1="2" x2="10" y2="4.5"/><line x1="14" y1="2" x2="14" y2="4.5"/>',
  dinner: '<path d="M5 3v6a2 2 0 1 0 4 0V3"/><line x1="7" y1="9" x2="7" y2="21"/><path d="M17 3v18"/><path d="M17 3c-1.7 0-3 1.9-3 4.5S15.3 12 17 12"/>',
  pool: '<path d="M2 16c1.5 0 1.5-1.5 3-1.5s1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5"/><path d="M2 11c1.5 0 1.5-1.5 3-1.5s1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5 1.5-1.5 3-1.5 1.5 1.5 3 1.5"/>',
  wifi: '<path d="M2 8.8a15 15 0 0 1 20 0"/><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 16a5 5 0 0 1 7 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>',
  laptop: '<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>',
  parking: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 17V7h3.5a3 3 0 0 1 0 6H9"/>',
  ac: '<line x1="12" y1="2" x2="12" y2="22"/><line x1="4" y1="6.5" x2="20" y2="17.5"/><line x1="20" y1="6.5" x2="4" y2="17.5"/>',
  fridge: '<rect x="5.5" y="2.5" width="13" height="19" rx="2"/><line x1="5.5" y1="10" x2="18.5" y2="10"/><line x1="8.5" y1="6" x2="8.5" y2="7.5"/><line x1="8.5" y1="13" x2="8.5" y2="15"/>',
  bed: '<path d="M2 4v16"/><path d="M2 9h16a3 3 0 0 1 3 3v8"/><path d="M2 16h19"/><path d="M6 9V6h6v3"/>',
  closet: '<path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/>',
  linen: '<rect x="3" y="6.5" width="18" height="4.5" rx="1.2"/><rect x="3" y="13" width="18" height="4.5" rx="1.2"/><line x1="7" y1="6.5" x2="7" y2="11"/><line x1="7" y1="13" x2="7" y2="17.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/>',
  clean: '<path d="m12 3 1.7 4.8L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7L12 3Z"/><path d="M18.5 14.5v3M17 16h3"/>',
  default: '<polyline points="20 6 9 17 4 12"/>',
};

const endereco = comoChegar.endereco || (siteConfig.contact?.address || '');
const mapQuery = encodeURIComponent('Hotel Cajueiro Guarujá ' + endereco);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} transparentHeader={true} hideTopBars={true}>

  <!-- ===== HERO estilo Trip.com: imagem + headline + barra de busca + banner sobreposto ===== -->
  <section class="relative">
    <!-- Fundo: foto (se houver), ou gradiente oceânico -->
    <div
      class="absolute inset-0 -z-10 bg-cover bg-bottom"
      style={heroImage
        ? `background-image: linear-gradient(180deg, rgba(38,51,28,.45), rgba(38,51,28,.7)), url('${heroImage}')`
        : 'background-image: linear-gradient(155deg, #16344f 0%, #235a80 48%, #3d86ac 100%)'}
    ></div>

    <div class="container-x pt-28 md:pt-36 pb-20 md:pb-[212px]">
      {hero.eyebrow && <p class="mono uppercase text-white/75 mb-4">{hero.eyebrow}</p>}
      <h1 class="font-display font-semibold tracking-tight text-white leading-[1.03] mb-4 whitespace-nowrap" style="font-size: clamp(1.75rem, 6.2vw, 4rem)">
        {hero.title}
      </h1>
      {hero.lead && <p class="text-lg md:text-xl text-white/90 leading-relaxed max-w-2xl mb-9">{hero.lead}</p>}

      <!-- Barra de busca horizontal -->
      <form
        id="booking-form"
        data-engine={booking.engineUrl}
        data-company={booking.companyId}
        data-newtab={booking.openInNewTab ? '1' : '0'}
        class="booking-bar relative z-20 bg-surface rounded-[20px] lg:rounded-[200px] shadow-2xl p-1 lg:pl-3 flex flex-col gap-1 w-full"
      >
       <div class="flex flex-col lg:flex-row lg:items-stretch gap-1 lg:gap-0 w-full">
        <!-- Datas (check-in → check-out) — abre calendário de 2 meses -->
        <div class="relative flex-1 min-w-0" id="dates-field">
          <button type="button" id="dates-trigger" class="flex items-center gap-3 w-full px-4 py-2 rounded-md hover:bg-elev transition cursor-pointer text-left">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="flex flex-col w-full min-w-0 leading-none">
              <span class="mono uppercase text-ink-faint text-[11px] tracking-wider mb-1">Datas</span>
              <span id="dates-label" class="text-ink font-semibold text-[15px] leading-none truncate">Selecionar datas</span>
            </span>
          </button>
          <input id="checkin" type="hidden" />
          <input id="checkout" type="hidden" />
          <div id="dates-pop" class="cal-pop hidden"></div>
        </div>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Hóspedes — abre seletor de quartos/adultos/crianças -->
        <div class="relative flex-1 min-w-0" id="guests-field">
          <button type="button" id="guests-trigger" class="flex items-center gap-3 w-full px-4 py-2 rounded-md hover:bg-elev transition cursor-pointer text-left">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            <span class="flex flex-col w-full min-w-0 leading-none">
              <span class="mono uppercase text-ink-faint text-[11px] tracking-wider mb-1">Hóspedes</span>
              <span id="guests-label" class="text-ink font-semibold text-[15px] leading-none truncate">2 adultos</span>
            </span>
          </button>
          <input id="rooms" type="hidden" value="1" />
          <input id="adultos" type="hidden" value="2" />
          <input id="criancas" type="hidden" value="0" />
          <div id="guests-pop" class="guests-pop hidden">
            <div class="gp-row">
              <div><div class="gp-t">Quartos</div></div>
              <div class="gp-ctrl">
                <button type="button" class="gp-btn" data-act="dec" data-t="rooms" aria-label="Menos quartos">&#8722;</button>
                <span class="gp-n" id="gp-rooms">1</span>
                <button type="button" class="gp-btn" data-act="inc" data-t="rooms" aria-label="Mais quartos">+</button>
              </div>
            </div>
            <div class="gp-row">
              <div><div class="gp-t">Adultos</div><div class="gp-s">18+ anos</div></div>
              <div class="gp-ctrl">
                <button type="button" class="gp-btn" data-act="dec" data-t="adults" aria-label="Menos adultos">&#8722;</button>
                <span class="gp-n" id="gp-adults">2</span>
                <button type="button" class="gp-btn" data-act="inc" data-t="adults" aria-label="Mais adultos">+</button>
              </div>
            </div>
            <div class="gp-row">
              <div><div class="gp-t">Crianças</div><div class="gp-s">0–12 anos</div></div>
              <div class="gp-ctrl">
                <button type="button" class="gp-btn" data-act="dec" data-t="children" aria-label="Menos crianças">&#8722;</button>
                <span class="gp-n" id="gp-children">0</span>
                <button type="button" class="gp-btn" data-act="inc" data-t="children" aria-label="Mais crianças">+</button>
              </div>
            </div>
            <div id="gp-ages" class="gp-ages hidden"></div>
          </div>
        </div>
        <div class="hidden lg:block w-px bg-rule/60 my-2"></div>
        <!-- Código promocional -->
        <div class="relative flex-1 min-w-0">
          <label for="cupom" class="flex items-center gap-3 w-full px-4 py-2 rounded-md hover:bg-elev transition cursor-text">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-faint shrink-0" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span class="flex flex-col w-full min-w-0 leading-none">
              <span class="mono uppercase text-ink-faint text-[11px] tracking-wider mb-1">{booking.labelCupom || 'Cupom'}</span>
              <input id="cupom" type="text" class="bg-transparent outline-none text-ink font-semibold text-[15px] leading-none w-full min-w-0 placeholder:text-ink-faint/70 placeholder:font-normal" placeholder={booking.placeholderCupom || 'Código promocional'} aria-label={booking.labelCupom || 'Código promocional'} />
            </span>
          </label>
        </div>
        <!-- Buscar -->
        <button type="submit" class="flex items-center justify-center gap-2 bg-[#55703A] text-bg text-sm font-semibold uppercase tracking-wide rounded-[200px] px-6 py-2 lg:my-0 mt-1 hover:brightness-95 transition shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          {booking.cta}
        </button>
       </div>
      </form>
      <script is:inline>
        (function () {
          var form = document.getElementById('booking-form');
          var ci = document.getElementById('checkin');
          var co = document.getElementById('checkout');
          if (!form || !ci || !co) return;

          // yyyy-mm-dd (input date) -> Date / formatos
          var iso = function (d) {
            return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
          };
          // yyyy-mm-dd -> dd/mm/yyyy (formato que o motor hbook espera)
          var toBR = function (v) {
            var p = (v || '').split('-');
            return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : '';
          };

          var MONTHS = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
          var MSHORT = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
          var WD = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];

          var today = new Date(); today.setHours(0, 0, 0, 0);
          var parseISO = function (v) { if (!v) return null; var p = v.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); };
          var sameDay = function (a, b) { return a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); };
          var fmtShort = function (d) { return d.getDate() + ' ' + MSHORT[d.getMonth()]; };
          var fmtLong = function (d) { return WD[d.getDay()] + ', ' + d.getDate() + ' ' + MSHORT[d.getMonth()]; };

          // ===================== CALENDÁRIO (datas) =====================
          var dTrigger = document.getElementById('dates-trigger');
          var dPop = document.getElementById('dates-pop');
          var dLabel = document.getElementById('dates-label');
          var checkin = null, checkout = null;
          var view = new Date(today.getFullYear(), today.getMonth(), 1);
          var nights = function () { return (checkin && checkout) ? Math.round((checkout - checkin) / 86400000) : 0; };

          function syncDates() {
            ci.value = checkin ? iso(checkin) : '';
            co.value = checkout ? iso(checkout) : '';
            if (checkin && checkout) {
              var n = nights();
              dLabel.innerHTML = fmtShort(checkin) + ' <span class="text-ink-faint">–</span> ' + fmtShort(checkout) + ' <span class="text-ink-faint">· ' + n + (n === 1 ? ' noite' : ' noites') + '</span>';
            } else if (checkin) {
              dLabel.innerHTML = fmtShort(checkin) + ' <span class="text-ink-faint">– saída</span>';
            } else {
              dLabel.textContent = 'Selecionar datas';
            }
          }

          function dayClass(dt) {
            var c = 'cal-day';
            if (dt < today) return c + ' is-disabled';
            if (sameDay(dt, checkin) || sameDay(dt, checkout)) c += ' is-sel';
            if (checkin && checkout) {
              if (dt > checkin && dt < checkout) c += ' is-range';
              if (sameDay(dt, checkin)) c += ' is-start';
              if (sameDay(dt, checkout)) c += ' is-end';
            }
            return c;
          }
          function buildMonth(y, m) {
            var dow = new Date(y, m, 1).getDay();
            var dim = new Date(y, m + 1, 0).getDate();
            var h = '<div class="cal-month"><div class="cal-mname">' + MONTHS[m] + ' ' + y + '</div><div class="cal-grid">';
            for (var w = 0; w < 7; w++) h += '<div class="cal-wd">' + WD[w] + '</div>';
            for (var b = 0; b < dow; b++) h += '<div></div>';
            for (var d = 1; d <= dim; d++) {
              var dt = new Date(y, m, d);
              var dis = dt < today;
              h += '<button type="button" class="' + dayClass(dt) + '" data-d="' + iso(dt) + '"' + (dis ? ' disabled' : '') + '>' + d + '</button>';
            }
            return h + '</div></div>';
          }
          function renderCal() {
            var y = view.getFullYear(), m = view.getMonth();
            var nx = new Date(y, m + 1, 1);
            var canPrev = !(y === today.getFullYear() && m === today.getMonth());
            var foot;
            if (checkin && checkout) { var n = nights(); foot = '<strong>' + fmtLong(checkin) + ' – ' + fmtLong(checkout) + '</strong> (' + n + (n === 1 ? ' noite' : ' noites') + ')'; }
            else if (checkin) foot = 'Selecione a data de saída';
            else foot = 'Selecione a data de entrada';
            dPop.innerHTML =
              '<button type="button" class="cal-arrow cal-prev' + (canPrev ? '' : ' is-off') + '" aria-label="Mês anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"/></svg></button>' +
              '<button type="button" class="cal-arrow cal-next" aria-label="Próximo mês"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg></button>' +
              '<div class="cal-months">' + buildMonth(y, m) + buildMonth(nx.getFullYear(), nx.getMonth()) + '</div>' +
              '<div class="cal-foot">' + foot + '</div>';
          }
          function openDates() { dPop.classList.remove('hidden'); view = new Date((checkin || today).getFullYear(), (checkin || today).getMonth(), 1); renderCal(); }
          function closeDates() { dPop.classList.add('hidden'); }

          dTrigger.addEventListener('click', function (e) { e.stopPropagation(); if (dPop.classList.contains('hidden')) { closeGuests(); openDates(); } else closeDates(); });
          dPop.addEventListener('click', function (e) {
            e.stopPropagation();
            var prev = e.target.closest('.cal-prev'), next = e.target.closest('.cal-next'), day = e.target.closest('.cal-day');
            if (prev) { if (!prev.classList.contains('is-off')) { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); renderCal(); } return; }
            if (next) { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); renderCal(); return; }
            if (day && !day.hasAttribute('disabled')) {
              var dt = parseISO(day.getAttribute('data-d'));
              if (!checkin || checkout) { checkin = dt; checkout = null; }
              else if (dt > checkin) { checkout = dt; }
              else { checkin = dt; checkout = null; }
              syncDates(); renderCal();
            }
          });

          // ===================== HÓSPEDES (quartos/adultos/crianças) =====================
          var gTrigger = document.getElementById('guests-trigger');
          var gPop = document.getElementById('guests-pop');
          var gLabel = document.getElementById('guests-label');
          var agesBox = document.getElementById('gp-ages');
          var adultosInp = document.getElementById('adultos');
          var criancasInp = document.getElementById('criancas');
          var roomsInp = document.getElementById('rooms');
          var counts = { rooms: 1, adults: 2, children: 0 };
          var mins = { rooms: 1, adults: 1, children: 0 };
          var maxs = { rooms: 6, adults: 12, children: 6 };
          var childAges = [];

          function renderAges() {
            agesBox.innerHTML = '';
            for (var i = 0; i < counts.children; i++) {
              var wrap = document.createElement('label');
              wrap.className = 'gp-age';
              var lb = document.createElement('span'); lb.textContent = 'Criança ' + (i + 1);
              var sel = document.createElement('select'); sel.className = 'child-age'; sel.setAttribute('aria-label', 'Idade da criança ' + (i + 1));
              for (var age = 0; age <= 12; age++) {
                var opt = document.createElement('option'); opt.value = String(age);
                opt.textContent = age === 0 ? '< 1 ano' : age + (age === 1 ? ' ano' : ' anos');
                sel.appendChild(opt);
              }
              sel.value = String(childAges[i] != null ? childAges[i] : 6);
              (function (idx, s) { s.addEventListener('change', function () { childAges[idx] = parseInt(s.value, 10); }); })(i, sel);
              wrap.appendChild(lb); wrap.appendChild(sel); agesBox.appendChild(wrap);
            }
            agesBox.classList.toggle('hidden', counts.children === 0);
          }
          function syncGuests() {
            document.getElementById('gp-rooms').textContent = counts.rooms;
            document.getElementById('gp-adults').textContent = counts.adults;
            document.getElementById('gp-children').textContent = counts.children;
            roomsInp.value = counts.rooms; adultosInp.value = counts.adults; criancasInp.value = counts.children;
            gPop.querySelectorAll('.gp-btn').forEach(function (btn) {
              var t = btn.getAttribute('data-t'), act = btn.getAttribute('data-act');
              btn.disabled = act === 'dec' ? counts[t] <= mins[t] : counts[t] >= maxs[t];
            });
            var parts = [counts.rooms + (counts.rooms === 1 ? ' quarto' : ' quartos'), counts.adults + (counts.adults === 1 ? ' adulto' : ' adultos')];
            if (counts.children > 0) parts.push(counts.children + (counts.children === 1 ? ' criança' : ' crianças'));
            gLabel.textContent = parts.join(', ');
          }
          function openGuests() { gPop.classList.remove('hidden'); }
          function closeGuests() { gPop.classList.add('hidden'); }

          gTrigger.addEventListener('click', function (e) { e.stopPropagation(); if (gPop.classList.contains('hidden')) { closeDates(); openGuests(); } else closeGuests(); });
          gPop.addEventListener('click', function (e) {
            e.stopPropagation();
            var btn = e.target.closest('.gp-btn');
            if (btn && !btn.disabled) {
              var t = btn.getAttribute('data-t'), act = btn.getAttribute('data-act');
              counts[t] = Math.max(mins[t], Math.min(maxs[t], counts[t] + (act === 'inc' ? 1 : -1)));
              if (t === 'children') { childAges = childAges.slice(0, counts.children); renderAges(); }
              syncGuests();
            }
          });

          // Fecha popovers ao clicar fora.
          document.addEventListener('click', function (e) {
            if (!dPop.classList.contains('hidden') && !dPop.contains(e.target) && !dTrigger.contains(e.target)) closeDates();
            if (!gPop.classList.contains('hidden') && !gPop.contains(e.target) && !gTrigger.contains(e.target)) closeGuests();
          });

          // Pré-preenche: check-in amanhã, check-out depois de amanhã (1 diária).
          checkin = new Date(today); checkin.setDate(today.getDate() + 1);
          checkout = new Date(today); checkout.setDate(today.getDate() + 2);
          syncDates(); syncGuests();

          // Ao buscar: monta a URL do motor de reservas com os parâmetros.
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var base = form.getAttribute('data-engine') || '';
            var company = form.getAttribute('data-company') || '';

            var params = new URLSearchParams();
            if (company) params.set('companyId', company);
            params.set('checkin', toBR(ci.value));
            params.set('checkout', toBR(co.value));
            params.set('adults', String(counts.adults));
            params.set('children', String(counts.children));
            params.set('rooms', String(counts.rooms));
            // uma idade por criança: childrenage repetido (childrenage=15&childrenage=17...)
            agesBox.querySelectorAll('select.child-age').forEach(function (s) {
              params.append('childrenage', s.value);
            });
            var cupom = ((document.getElementById('cupom') || {}).value || '').trim();
            if (cupom) params.set('promocode', cupom);

            // URLSearchParams codifica "/" como %2F; o motor aceita a barra crua,
            // então repõe pra ficar igual ao link nativo (dd/mm/aaaa).
            var query = params.toString().replace(/%2F/gi, '/');
            var url = base + '?' + query;

            if (form.getAttribute('data-newtab') === '1') {
              window.open(url, '_blank', 'noopener');
            } else {
              window.location.href = url;
            }
          });
        })();
      </script>

      <style is:global>
        /* ---- Popovers do buscador (datas + hóspedes) ---- */
        .cal-pop, .guests-pop {
          position: absolute; top: 100%; margin-top: .6rem; z-index: 60;
          background: rgb(var(--c-surface)); border: 1px solid rgb(var(--c-rule));
          border-radius: 1.1rem; box-shadow: 0 24px 60px -15px rgba(0,0,0,.4);
        }
        .cal-pop { left: 0; padding: 2.6rem 1.25rem 1rem; width: min(640px, 94vw); }
        .guests-pop { right: 0; padding: .35rem .25rem .7rem; width: min(340px, 92vw); }
        @media (max-width: 1023px) { .cal-pop { left: 0; } }

        .cal-months { display: grid; grid-template-columns: 1fr; gap: 1.75rem; }
        @media (min-width: 640px) { .cal-months { grid-template-columns: 1fr 1fr; } }
        .cal-mname { text-align: center; font-weight: 600; color: rgb(var(--c-ink)); margin-bottom: .75rem; }
        .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
        .cal-wd { text-align: center; font-size: .68rem; text-transform: uppercase; letter-spacing: .03em; color: rgb(var(--c-ink-faint)); padding-bottom: .35rem; }
        .cal-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: .9rem; color: rgb(var(--c-ink)); border: 0; background: transparent; cursor: pointer; border-radius: .55rem; transition: background .12s; }
        .cal-day:hover { background: rgb(var(--c-elev)); }
        .cal-day.is-disabled { color: rgb(var(--c-ink-faint)); opacity: .4; cursor: default; }
        .cal-day.is-range { background: rgba(207,58,35,.12); border-radius: 0; }
        .cal-day.is-sel { background: #cf3a23; color: #fff; }
        .cal-day.is-start { border-top-right-radius: 0; border-bottom-right-radius: 0; }
        .cal-day.is-end { border-top-left-radius: 0; border-bottom-left-radius: 0; }
        .cal-arrow { position: absolute; top: 1rem; width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; border-radius: 9999px; color: rgb(var(--c-ink)); background: transparent; border: 0; cursor: pointer; }
        .cal-arrow:hover { background: rgb(var(--c-elev)); }
        .cal-prev { left: 1rem; } .cal-next { right: 1rem; }
        .cal-arrow.is-off { opacity: .25; cursor: default; }
        .cal-foot { margin-top: 1rem; text-align: right; font-size: .85rem; color: rgb(var(--c-ink-muted)); }

        .gp-row { display: flex; align-items: center; justify-content: space-between; padding: .7rem 1rem; }
        .gp-t { font-weight: 600; color: rgb(var(--c-ink)); }
        .gp-s { font-size: .74rem; color: rgb(var(--c-ink-faint)); }
        .gp-ctrl { display: flex; align-items: center; gap: .9rem; }
        .gp-btn { width: 2rem; height: 2rem; border-radius: 9999px; border: 1.5px solid #cf3a23; color: #cf3a23; background: transparent; font-size: 1.15rem; line-height: 1; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .12s; }
        .gp-btn:hover { background: rgba(207,58,35,.08); }
        .gp-btn:disabled { opacity: .35; cursor: default; border-color: rgb(var(--c-rule)); color: rgb(var(--c-ink-faint)); }
        .gp-n { min-width: 1.5rem; text-align: center; font-weight: 600; color: rgb(var(--c-ink)); }
        .gp-ages { display: flex; flex-wrap: wrap; gap: .6rem; padding: .3rem 1rem .7rem; }
        .gp-age { display: flex; flex-direction: column; gap: .25rem; font-size: .7rem; color: rgb(var(--c-ink-faint)); }
        .gp-age select { border: 1px solid rgb(var(--c-rule)); border-radius: .5rem; padding: .35rem .5rem; font-size: .85rem; color: rgb(var(--c-ink)); background: rgb(var(--c-bg)); }
        .gp-foot { padding: .5rem 1rem .8rem; display: flex; justify-content: flex-end; }
        .gp-done { background: #cf3a23; color: #fff; border: 0; border-radius: 9999px; padding: .55rem 1.6rem; font-size: .82rem; font-weight: 600; text-transform: uppercase; letter-spacing: .03em; cursor: pointer; }
        .gp-done:hover { filter: brightness(.95); }
      </style>
    </div>

  </section>

  <!-- ===== BANNER (abaixo da hero) — painel arredondado que sobe sobre a imagem ===== -->
  {(banner.title || banner.text) && (
    <section class="relative z-10 bg-bg md:rounded-t-[50px] md:-mt-10">
      <div class="container-x py-12 md:py-16">
        <div class="bg-elev rounded-lg border border-rule/60 overflow-hidden flex flex-col md:flex-row">
          <!-- Texto (70%) -->
          <div class="md:w-[70%] p-6 md:p-10">
            {banner.eyebrow && <p class="mono uppercase text-primary mb-3">{banner.eyebrow}</p>}
            <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight text-ink leading-[1.15] mb-3">{banner.title}</h2>
            {banner.text && <p class="text-base md:text-lg text-ink-muted leading-relaxed">{banner.text}</p>}
          </div>
          <!-- Imagem (30%) -->
          <div class="md:w-[30%] min-h-[200px] md:min-h-0 bg-cover bg-center flex items-center justify-center"
               style={banner.image ? `background-image: url('${banner.image}')` : ''}>
            {!banner.image && <span class="mono uppercase text-ink-faint text-xs">imagem</span>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===== 3 FEATURES (icone + texto) ===== -->
  {features.length > 0 && (
    <section class="">
      <div class="container-x py-14 md:py-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {features.map((f: any) => (
            <div>
              <div class="w-11 h-11 rounded border border-rule flex items-center justify-center mb-4 text-ink" aria-hidden="true">
                <span class="mono uppercase text-ink-faint text-xs">{f.icon}</span>
              </div>
              <h3 class="font-sans font-semibold text-lg text-ink mb-2">{f.title}</h3>
              <p class="text-base text-ink-muted leading-relaxed">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== INTRO ===== -->
  {(intro.title || intro.text) && (
    <section class="">
      <div class="container-x py-16 md:py-24">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
          <div class="md:col-span-5">
            <h2 class="font-display text-2xl md:text-3xl font-normal leading-[1.1] tracking-tight text-ink">{intro.title}</h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            {intro.text && <div class="text-lg text-ink-muted leading-relaxed space-y-4">{intro.text.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===== ACOMODAÇÕES (grid de suítes) ===== -->
  {(suitesTeaser.title || suitesTeaser.text) && (
    <section id="acomodacoes" class="bg-elev  scroll-mt-24">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-10 md:mb-14">
          {suitesTeaser.eyebrow && <p class="mono uppercase text-[#cf3a23] mb-3">{suitesTeaser.eyebrow}</p>}
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{suitesTeaser.title}</h2>
          {suitesTeaser.text && <p class="text-lg text-ink-muted leading-relaxed">{suitesTeaser.text}</p>}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-7">
          {(suitesTeaser.suites || []).map((s: any) => (
            <article class="bg-surface rounded-lg overflow-hidden shadow-sm border border-rule/40 flex flex-col">
              <img src={s.img} alt={s.nome} width="600" height="400" loading="lazy" class="w-full object-cover" style="height:200px" />
              <div class="p-6 flex flex-col flex-1">
                <h3 class="font-display text-xl font-semibold text-ink mb-2">{s.nome}</h3>
                <p class="text-sm text-ink-muted leading-relaxed">{s.desc}</p>
              </div>
            </article>
          ))}

          {suitesTeaser.destaque && (
            <article class="rounded-lg p-6 md:p-8 flex flex-col" style="background:#2f3d22;">
              <div class="w-12 h-12 rounded-full flex items-center justify-center mb-5" style="background:rgba(255,255,255,0.08);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c9b26a" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4v16"/><path d="M2 9h18a2 2 0 012 2v9"/><path d="M2 18h20"/><path d="M6 9V6a2 2 0 012-2h8"/></svg>
              </div>
              <h3 class="font-display text-xl font-semibold mb-2.5" style="color:#F4EEDD;">{suitesTeaser.destaque.title}</h3>
              <p class="text-sm leading-relaxed mb-6 flex-1" style="color:#b9bea9;">{suitesTeaser.destaque.text}</p>
              {suitesTeaser.destaque.cta && <a href="#reservar" class="inline-flex items-center justify-center gap-2.5 min-h-[44px] px-6 rounded-[200px] bg-[#cf3a23] text-white text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter] self-start">{suitesTeaser.destaque.cta}</a>}
            </article>
          )}
        </div>

        {suitesTeaser.cta && (
          <div class="mt-10 md:mt-12">
            <a href="/suites" class="inline-flex items-center justify-center gap-2.5 min-h-[48px] px-6 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">{suitesTeaser.cta}</a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ===== ESTRUTURA (o que o hotel oferece) ===== -->
  {estrutura.itens && estrutura.itens.length > 0 && (
    <section id="estrutura" class=" scroll-mt-24">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-10 md:mb-12">
          {estrutura.eyebrow && <p class="mono uppercase text-[#cf3a23] mb-3">{estrutura.eyebrow}</p>}
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{estrutura.title}</h2>
          {estrutura.text && <p class="text-lg text-ink-muted leading-relaxed">{estrutura.text}</p>}
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {estrutura.itens.map((a: any) => (
            <li class="flex items-center gap-3.5 bg-surface rounded-md px-5 py-4 border border-rule/40 shadow-[0_1px_2px_rgba(60,45,25,.06)]">
              <svg class="w-5 h-5 shrink-0 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={AICON[a.icon] || AICON.default}></svg>
              <span class="text-sm font-medium text-ink leading-snug">{a.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ===== PISCINA + LOCALIZAÇÃO ===== -->
  <section class="">
    <div class="container-x py-16 md:py-24 grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      {(piscina.title || piscina.text) && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{piscina.title}</h2>
          {piscina.text && <p class="text-lg text-ink-muted leading-relaxed mb-6">{piscina.text}</p>}
          {piscina.cta && <a href="/hotel" class="mono uppercase text-ink-faint hover:text-ink transition">{piscina.cta}</a>}
        </div>
      )}
      {(localizacao.title || localizacao.text) && (
        <div>
          <h2 class="font-display text-2xl md:text-3xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{localizacao.title}</h2>
          {localizacao.text && <div class="text-lg text-ink-muted leading-relaxed space-y-4">{localizacao.text.split('\n\n').map((p: string) => <p>{p}</p>)}</div>}
        </div>
      )}
    </div>
  </section>

  <!-- ===== DIFERENCIAIS ===== -->
  {diferenciais.items && diferenciais.items.length > 0 && (
    <section class="">
      <div class="container-x py-16 md:py-24">
        <div class="max-w-2xl mb-12">
          <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-4">{diferenciais.title}</h2>
          {diferenciais.subtitle && <p class="text-lg text-ink-muted leading-relaxed mb-6">{diferenciais.subtitle}</p>}
          {diferenciais.cta && <a href="#reservar" class="inline-flex items-center justify-center gap-2.5 min-h-[48px] px-6 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">{diferenciais.cta}</a>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {diferenciais.items.map((it: any) => (
            <div class=" pt-5">
              <h3 class="font-sans font-semibold text-lg text-ink mb-2">{it.title}</h3>
              <p class="text-base text-ink-muted leading-relaxed">{it.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== DEPOIMENTOS ===== -->
  {depoimentos.length > 0 && (
    <section class="">
      <div class="container-x py-16 md:py-24">
        {depoimentos.map((d: any) => (
          <figure class="max-w-3xl">
            <blockquote class="font-display text-2xl md:text-3xl font-normal text-ink leading-[1.25] mb-6">"{d.text}"</blockquote>
            <figcaption class="mono uppercase text-ink-faint">— {d.author}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ===== FAQ ===== -->
  {faq.length > 0 && (
    <section class="">
      <div class="container-x py-16 md:py-24">
        <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-10">Perguntas frequentes</h2>
        <div class="max-w-3xl divide-y divide-rule ">
          {faq.map((item: any) => (
            <details class="group py-5">
              <summary class="cursor-pointer font-sans font-semibold text-lg text-ink list-none flex justify-between items-center">
                {item.q}
                <span class="text-ink-faint group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
              </summary>
              <p class="text-base text-ink-muted leading-relaxed mt-3">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===== COMO CHEGAR ===== -->
  {(comoChegar.title || endereco) && (
    <section id="como-chegar" class=" scroll-mt-24">
      <div class="container-x py-16 md:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
          <div>
            {comoChegar.eyebrow && <p class="mono uppercase text-[#cf3a23] mb-3">{comoChegar.eyebrow}</p>}
            <h2 class="font-display text-3xl md:text-4xl font-normal tracking-tight text-ink leading-[1.1] mb-5">{comoChegar.title}</h2>
            {endereco && (
              <div class="flex gap-2.5 items-start mb-6">
                <svg class="w-5 h-5 mt-0.5 shrink-0 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span class="text-[15px] leading-relaxed text-ink">{endereco}</span>
              </div>
            )}
            <div class="flex flex-col gap-4 mb-7">
              {(comoChegar.acessos || []).map((r: any) => (
                <div class="flex gap-3.5 items-start">
                  <span class="shrink-0 w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(207,58,35,0.10);">
                    <svg class="w-5 h-5 text-[#cf3a23]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  </span>
                  <div>
                    <div class="text-[15px] font-semibold text-ink">{r.titulo}</div>
                    <div class="text-sm text-ink-muted leading-relaxed">{r.texto}</div>
                  </div>
                </div>
              ))}
            </div>
            <a href={mapHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 min-h-[44px] px-6 rounded-[200px] bg-[#26331C] text-[#F4EEDD] text-sm font-semibold uppercase tracking-wide no-underline hover:brightness-110 transition-[filter]">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Ver no mapa
            </a>
          </div>
          <div class="rounded-lg overflow-hidden border border-border shadow-[0_30px_60px_-30px_rgba(60,45,25,.35)]">
            <iframe src={mapEmbed} title="Como chegar ao Hotel Cajueiro Guarujá" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full block" style="border:0; height:380px;"></iframe>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===== CTA FINAL ===== -->
  {(cta.title || cta.button) && (
    <section id="reservar" class="bg-elev ">
      <div class="container-x py-20 md:py-28 text-center">
        <h2 class="font-display text-3xl md:text-5xl font-normal tracking-tight text-ink leading-[1.05] max-w-3xl mx-auto mb-5">{cta.title}</h2>
        {cta.subtitle && <p class="text-lg text-ink-muted leading-relaxed max-w-2xl mx-auto mb-8">{cta.subtitle}</p>}
        {cta.button && <a href="/contato" class="inline-flex items-center justify-center gap-2.5 min-h-[52px] px-8 rounded-[200px] bg-[#cf3a23] text-white text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]">{cta.button}</a>}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* Esconde o ícone nativo do date picker — usamos só o ícone de calendário à esquerda.
     O clique na área toda abre o picker (via showPicker no JS).
     :global pra atravessar o escopo do Astro e atingir o pseudo nativo. */
  :global(.booking-date::-webkit-calendar-picker-indicator) { display: none; }
  .booking-date { cursor: pointer; }
  /* Remove a setinha default do select no Safari/Chrome pra ficar mais limpo */
  .booking-bar select { appearance: none; -webkit-appearance: none; }
</style>
