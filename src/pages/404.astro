---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readData } from '../lib/readData';

const siteConfig = readData('siteConfig.json');
const waDigits = (siteConfig.contact?.whatsapp || '').replace(/\D/g, '');
const waUrl = waDigits ? `https://wa.me/55${waDigits}` : '';

// Atalhos úteis para quem caiu aqui por link antigo ou erro de digitação.
const atalhos = [
    { href: '/#reservar', title: 'Reservar uma suíte', desc: 'Consulte datas e veja a disponibilidade na hora.' },
    { href: '/suites-hotel-cajueiro-guaruja', title: 'Ver as suítes', desc: 'De individual a quádrupla, com ou sem varanda.' },
    { href: '/o-que-fazer-hotel-cajueiro-guaruja', title: 'O que fazer no Guarujá', desc: 'Praias, passeios e dicas de quem vive aqui.' },
    { href: 'https://wa.me/5513991439331', title: 'Falar com a recepção', desc: 'Estamos disponíveis 24 horas, todos os dias.' },
];
---

<BaseLayout title="Página não encontrada" description="404 — esta página não existe">
    <div class="container-x py-24 md:py-32">
        <div class="max-w-2xl">
            <p class="mono uppercase text-ink-faint mb-5">erro 404</p>
            <h1
                class="font-display text-4xl md:text-6xl font-semibold tracking-tight text-ink leading-[1.05] mb-6"
            >
                Essa página não existe.
            </h1>
            <p class="text-lg text-ink-muted mb-10 max-w-prose-lg leading-relaxed">
                O endereço pode ter mudado de lugar. Se você estava procurando uma suíte ou tirar
                uma dúvida sobre a sua reserva, os caminhos abaixo resolvem.
            </p>
            <div class="flex gap-3 flex-wrap">
                <a
                    href="/"
                    class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-[200px] bg-[#cf3a23] text-bg text-[15px] font-semibold uppercase tracking-wide no-underline hover:brightness-95 transition-[filter]"
                    >Voltar para o início</a
                >
                {
                    waUrl && (
                        <a
                            href={waUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-[200px] border border-ink/15 text-ink text-[15px] font-semibold uppercase tracking-wide no-underline hover:bg-ink/5 transition-colors"
                        >
                            Falar no WhatsApp
                        </a>
                    )
                }
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-14 md:mt-20 max-w-4xl">
            {
                atalhos.map((a) => (
                    <a
                        href={a.href}
                        class="block bg-surface border border-rule/40 rounded-lg p-6 no-underline shadow-[0_1px_2px_rgba(60,45,25,.06)] hover:-translate-y-0.5 transition-transform duration-300"
                    >
                        <h2 class="font-display text-lg font-semibold text-ink mb-1.5">{a.title}</h2>
                        <p class="text-sm text-ink-muted leading-relaxed">{a.desc}</p>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>
