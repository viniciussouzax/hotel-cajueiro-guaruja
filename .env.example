# Senha do painel admin. Use algo FORTE e único (12+ caracteres, sem ser
# sequência óbvia). É a única barreira na frente da escrita no seu repo.
# Gere uma: `openssl rand -base64 18`
ADMIN_SECRET=troque-por-uma-senha-forte
# Para produção (Vercel):
# GITHUB_TOKEN=ghp_...
# GITHUB_OWNER=seu-usuario
# GITHUB_REPO=nome-do-repo

# Avaliações reais do Google na home (Places API New).
# Chave do Google Cloud com a "Places API (New)" habilitada. O uso é só
# server-side (/api/reviews), então restrinja a chave POR API, não por referer.
# O Place ID do hotel vai em src/data/pluginsConfig.json → googleReviews.placeId
# GOOGLE_MAPS_API_KEY=AIza...
